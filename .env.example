# Backend
PORT=4100
PYTHON_BIN=python3

# Stripe Test Mode — tuyệt đối không đưa sk_test vào mobile hoặc commit file
# .env.server. App dùng Stripe CardField + PaymentIntent native; chỉ pk_test
# được API cấu hình trả cho SDK mobile. Refund vẫn được gọi từ Admin.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CURRENCY=vnd
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_MERCHANT_DISPLAY_NAME="JAPANO Store"
# Tùy chọn khi dùng Stripe CLI/webhook public.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Python dùng cho YOLO pose/phụ kiện; phải có numpy, OpenCV và Ultralytics.
JAPANO_ACCESSORY_PYTHON=/home/nhat/.pyenv/shims/python3

# FASHN VTON 1.5 mặc đồ; FLUX.2 Klein 4B đổi tư thế khi ảnh khó.
JAPANO_FASHN_URL=http://127.0.0.1:7862
JAPANO_FASHN_HOME=/home/nhat/jp/ai/fashn-vton-1.5
JAPANO_FASHN_WEIGHTS=/home/nhat/jp/ai/fashn-vton-1.5/weights
JAPANO_FLUX_REPOSE_HOME=/home/nhat/jp/ai/FLUX.2-klein-4B
JAPANO_TRYON_RUNTIME_DIR=/tmp/japano-tryon-runtime
JAPANO_FASHN_STEPS=30
JAPANO_FASHN_CFG=1.5
JAPANO_REPOSE_STEPS=4
# Làm đẹp phụ kiện bằng FLUX.2 multi-reference sau bước ghép pose. Hệ thống tự
# đổi seed tối đa 2 lần khi quality gate phát hiện che mặt/sai tay/sai trang phục.
JAPANO_ACCESSORY_REFINE=1
JAPANO_ACCESSORY_REFINE_STEPS=4
JAPANO_ACCESSORY_REFINE_CFG=1.0
JAPANO_ACCESSORY_REFINE_ATTEMPTS=2
JAPANO_ACCESSORY_REFINE_SEED=101
JAPANO_ACCESSORY_REFINE_TIMEOUT_MS=420000
# Chỉ đổi pose khi detector thấy ảnh khó; tiết kiệm VRAM cho emulator/RDP.
JAPANO_FORCE_REPOSE=0
JAPANO_FASHN_FIDELITY_REFINE=0
JAPANO_TRYON_LOW_MEMORY=1
JAPANO_FLUX_OFFLOAD=sequential
JAPANO_UNLOAD_AFTER_TRYON=1
# Tự unload model Ollama khỏi VRAM ngay trước try-on; model không bị xóa và sẽ
# tự load lại ở request chatbot/vision tiếp theo.
JAPANO_RELEASE_OLLAMA_VRAM=1
JAPANO_TRYON_GPU_LOCK=/tmp/japano-tryon-gpu.active
JAPANO_OLLAMA_UNLOAD_TIMEOUT_SEC=30
JAPANO_MIN_GPU_FREE_GB=8
JAPANO_TRYON_AUTO_ATTEMPTS=2
# Chỉ các flat-lay đã xem thủ công và không còn da/người/nền mới được dùng.
JAPANO_APPROVED_TRYON_FLATS=kimono-hong,ao-len-cardigan,yumeko
# CatVTON chỉ là fallback tùy chọn và mặc định TẮT. GPU 16GB không nên giữ
# CatVTON đồng thời với FASHN + FLUX.2.
JAPANO_CATVTON_URL=http://127.0.0.1:7861
JAPANO_CATVTON_FALLBACK=0
JAPANO_SKIP_CATVTON=1
JAPANO_AI_GATEWAY_URL=http://127.0.0.1:8001
JAPANO_OLLAMA_URL=http://127.0.0.1:11434
JAPANO_OLLAMA_MODEL=qwen2.5:7b
# Mặc định tắt để chatbot không tự thêm tên sản phẩm ngoài catalog.
JAPANO_OLLAMA_CHAT=0
JAPANO_VISION_MODEL=qwen3-vl:8b
JAPANO_VISION_TIMEOUT_MS=120000
JAPANO_GOALS_MODEL=qwen2.5:7b
JAPANO_GOALS_LLM=1
JAPANO_GOALS_TIMEOUT_MS=90000
JAPANO_CATVTON_DISABLE=0
JAPANO_TRYON_TIMEOUT_MS=900000

# Mobile: Android emulator dùng 10.0.2.2; start-all.sh sẽ tự đặt URL và adb reverse.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4100
EXPO_PUBLIC_API_PORT=4100
EXPO_PUBLIC_API_TIMEOUT_MS=20000
EXPO_PUBLIC_TRYON_TIMEOUT_MS=720000

# Script kiểm tra API (npm run verify / npm run verify:ai).
JAPANO_API_URL=http://127.0.0.1:4100
