# Frontend Expo
# Web có thể để trống EXPO_PUBLIC_API_URL để app tự bắt đúng backend theo host hiện tại.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# Stripe publishable key: được phép dùng ở frontend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Backend server
PORT=4000
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/japano?retryWrites=true&w=majority"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_MS=9000
GEMINI_COOLDOWN_MS=120000

FOTOR_API_KEY=""
FOTOR_PROVIDER="gemini-3-pro-image-preview"
DEMO_MODE=1

PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# Stripe server key: chỉ để ở backend, không commit lên GitHub.
# Có thể dùng sk_test_... hoặc rk_test_... nếu restricted key đã được cấp đủ quyền PaymentIntents/Customers/Ephemeral Keys.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_RESTRICTED_KEY=""
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_CURRENCY=vnd
STRIPE_API_VERSION=2024-06-20
STRIPE_MERCHANT_DISPLAY_NAME="JAPANO Fashion AI"

# Cloudinary: lưu ảnh/video/audio/file trên Cloudinary qua backend.
# CLOUDINARY_URL có dạng: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
CLOUDINARY_ROOT_FOLDER="japano"
