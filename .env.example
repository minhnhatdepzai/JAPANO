# Backend
PORT=4100
PYTHON_BIN=python3
NODE_ENV=development
# Để trống để dùng backend/data/db.json. Có thể đổi sang một file JSON khác.
JAPANO_DATA_FILE=

# Auth thật (bcrypt + JWT). BẮT BUỘC phải đặt JWT_SECRET trước khi chạy
# production — thiếu thì server sẽ từ chối khởi động khi NODE_ENV=production
# (dev thì tự sinh secret tạm, token mất hiệu lực mỗi lần restart).
JWT_SECRET=doi-chuoi-ngau-nhien-dai-o-day
JWT_TTL=30d
# Đặt 2 dòng dưới để tự tạo/thăng hạng đúng 1 tài khoản admin lúc boot lần đầu
# (không đụng mật khẩu nếu tài khoản đã có sẵn, để tránh ghi đè mật khẩu đã đổi).
JAPANO_ADMIN_EMAIL=admin@japano.local
JAPANO_ADMIN_PASSWORD=doi-mat-khau-nay

# Quan sát/vận hành — để trống thì chỉ log ra console, không ảnh hưởng app.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
JAPANO_RATE_LIMIT_MAX=600
JAPANO_AUTH_RATE_LIMIT_MAX=20

# Semantic embeddings cho related-products — service Python riêng
# (backend/embedding_service.py, sentence-transformers) ưu tiên CUDA, chỉ rơi
# về CPU khi máy không có GPU, giống fashn_service.py/catvton_service.py.
# start-all.sh tự khởi động; đặt JAPANO_SKIP_EMBEDDING=1 để tắt hẳn (chỉ mất
# tín hiệu semantic cho related-products, engine gợi ý chính không ảnh hưởng).
JAPANO_EMBEDDING_URL=http://127.0.0.1:7865
JAPANO_EMBEDDING_DIR=/absolute/path/to/embedding-service
JAPANO_EMBEDDING_PYTHON=/absolute/path/to/embedding-service/.venv/bin/python
JAPANO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
JAPANO_SKIP_EMBEDDING=0

# Lưu trữ cloud tùy chọn; core vẫn chạy khi để trống (chỉ dùng file JSON cục bộ).
# Đặt MONGODB_URI thì state (db.json) được mirror sang MongoDB sau mỗi lần ghi,
# và tự nạp lại từ Mongo lúc khởi động nếu Mongo có dữ liệu mới hơn file cục bộ
# — nhiều máy/nhiều lần deploy cùng thấy 1 nguồn dữ liệu thay vì mỗi máy 1 file.
MONGODB_URI=
MONGODB_DB=japano
CLOUDINARY_URL=

# Stripe Test Mode — tuyệt đối không đưa sk_test vào mobile hoặc commit file
# .env.server. App dùng Stripe CardField + PaymentIntent native; chỉ pk_test
# được API cấu hình trả cho SDK mobile. Refund vẫn được gọi từ Admin.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CURRENCY=vnd
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_MERCHANT_DISPLAY_NAME="JAPANO Store"
# Tùy chọn khi dùng Stripe CLI/webhook public.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# VNPay Sandbox — điền merchant code/secret của môi trường thử nghiệm vào
# .env.server; app mở URL thanh toán trong WebView. Refund gọi qua Merchant
# WebApi (Command=refund) bên dưới.
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://japano.app/vnpay-return
# Python dùng cho YOLO pose/phụ kiện; phải có numpy, OpenCV và Ultralytics.
JAPANO_ACCESSORY_PYTHON=python3

# FASHN VTON 1.5 mặc đồ; FLUX.2 Klein 4B đổi tư thế khi ảnh khó.
JAPANO_FASHN_URL=http://127.0.0.1:7862
JAPANO_FASHN_DIR=/absolute/path/to/fashn-vton-1.5
JAPANO_FASHN_HOME=/absolute/path/to/fashn-vton-1.5
JAPANO_FASHN_WEIGHTS=/absolute/path/to/fashn-vton-1.5/weights
JAPANO_FASHN_PYTHON=/absolute/path/to/fashn-vton-1.5/.venv/bin/python
JAPANO_FLUX_REPOSE_HOME=/absolute/path/to/FLUX.2-klein-4B
JAPANO_TRYON_RUNTIME_DIR=/tmp/japano-tryon-runtime
JAPANO_FASHN_STEPS=30
JAPANO_FASHN_CFG=1.5
JAPANO_REPOSE_STEPS=4
# Làm đẹp phụ kiện bằng FLUX.2 multi-reference sau bước ghép pose. Hệ thống tự
# đổi seed tối đa 2 lần khi quality gate phát hiện che mặt/sai tay/sai trang phục.
JAPANO_ACCESSORY_REFINE=1
JAPANO_ACCESSORY_REFINE_STEPS=4
JAPANO_ACCESSORY_REFINE_CFG=1.0
JAPANO_ACCESSORY_REFINE_ATTEMPTS=2
JAPANO_ACCESSORY_REFINE_SEED=101
JAPANO_ACCESSORY_REFINE_TIMEOUT_MS=420000
# Chỉ đổi pose khi detector thấy ảnh khó; tiết kiệm VRAM cho emulator/RDP.
JAPANO_FORCE_REPOSE=0
JAPANO_FASHN_FIDELITY_REFINE=0
JAPANO_TRYON_LOW_MEMORY=1
JAPANO_FLUX_OFFLOAD=sequential
JAPANO_UNLOAD_AFTER_TRYON=1
# Tự unload model Ollama khỏi VRAM ngay trước try-on; model không bị xóa và sẽ
# tự load lại ở request chatbot/vision tiếp theo.
JAPANO_RELEASE_OLLAMA_VRAM=1
JAPANO_TRYON_GPU_LOCK=/tmp/japano-tryon-gpu.active
JAPANO_OLLAMA_UNLOAD_TIMEOUT_SEC=30
JAPANO_MIN_GPU_FREE_GB=8
JAPANO_TRYON_AUTO_ATTEMPTS=2
# Chỉ các flat-lay đã xem thủ công và không còn da/người/nền mới được dùng.
JAPANO_APPROVED_TRYON_FLATS=kimono-hong,ao-len-cardigan,yumeko
# CatVTON chỉ là fallback tùy chọn và mặc định TẮT. GPU 16GB không nên giữ
# CatVTON đồng thời với FASHN + FLUX.2.
JAPANO_CATVTON_URL=http://127.0.0.1:7861
JAPANO_CATVTON_DIR=/absolute/path/to/CatVTON
JAPANO_CATVTON_PYTHON=/absolute/path/to/CatVTON/.venv/bin/python
JAPANO_CATVTON_FALLBACK=0
JAPANO_SKIP_CATVTON=1
JAPANO_MOTION_URL=http://127.0.0.1:7864
JAPANO_ONE_TO_ALL_HOME=/absolute/path/to/One-to-All-Animation
JAPANO_ONE_TO_ALL_PYTHON=/absolute/path/to/One-to-All-Animation/.venv/bin/python
JAPANO_ONE_TO_ALL_CHECKPOINT=One-to-All-1.3b_1
JAPANO_MOTION_ENGINE_LABEL=one-to-all-animation-1.3b-v1
# Gemini API video chạy cloud, luôn giữ key ở backend/.env.server và không
# đặt tiền tố EXPO_PUBLIC_. Test thủ công bằng scripts/test-gemini-video.mjs.
GEMINI_API_KEY=
JAPANO_GEMINI_VIDEO_MODEL=gemini-omni-flash-preview
JAPANO_GEMINI_VIDEO_TIMEOUT_MS=600000
# Các cờ dưới đây chỉ được start-all.sh đọc.
JAPANO_SKIP_FASHN=0
JAPANO_SKIP_MOTION=0
JAPANO_AI_GATEWAY_URL=http://127.0.0.1:8001
JAPANO_OLLAMA_URL=http://127.0.0.1:11434
JAPANO_OLLAMA_MODEL=qwen2.5:7b
# Mặc định tắt để chatbot không tự thêm tên sản phẩm ngoài catalog.
JAPANO_OLLAMA_CHAT=0
JAPANO_VISION_MODEL=qwen3-vl:8b
JAPANO_VISION_TIMEOUT_MS=120000
JAPANO_GOALS_MODEL=qwen2.5:7b
JAPANO_GOALS_LLM=1
JAPANO_GOALS_TIMEOUT_MS=90000
JAPANO_CATVTON_DISABLE=0
JAPANO_TRYON_TIMEOUT_MS=900000

# Mobile: Android emulator dùng 10.0.2.2; start-all.sh sẽ tự đặt URL và adb reverse.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4100
EXPO_PUBLIC_API_PORT=4100
EXPO_PUBLIC_API_TIMEOUT_MS=20000
EXPO_PUBLIC_TRYON_TIMEOUT_MS=720000

# Script kiểm tra API (npm run verify / npm run verify:ai).
JAPANO_API_URL=http://127.0.0.1:4100
