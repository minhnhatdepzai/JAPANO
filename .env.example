# Backend
PORT=4100
PYTHON_BIN=python3
NODE_ENV=development
# Chỉ dùng khi chưa cấu hình MONGODB_URI: file seed/fallback JSON cục bộ.
JAPANO_DATA_FILE=

# Auth thật (bcrypt + JWT). BẮT BUỘC phải đặt JWT_SECRET trước khi chạy
# production — thiếu thì server sẽ từ chối khởi động khi NODE_ENV=production
# (dev thì tự sinh secret tạm, token mất hiệu lực mỗi lần restart).
JWT_SECRET=doi-chuoi-ngau-nhien-dai-o-day
JWT_TTL=30d
# Đặt 2 dòng dưới để tự tạo/thăng hạng đúng 1 tài khoản admin lúc boot lần đầu
# (không đụng mật khẩu nếu tài khoản đã có sẵn, để tránh ghi đè mật khẩu đã đổi).
JAPANO_ADMIN_EMAIL=admin@japano.local
JAPANO_ADMIN_PASSWORD=doi-mat-khau-nay

# Quan sát/vận hành — để trống thì chỉ log ra console, không ảnh hưởng app.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
JAPANO_RATE_LIMIT_MAX=600
JAPANO_AUTH_RATE_LIMIT_MAX=20

# Semantic embeddings cho related-products — service Python riêng
# (backend/embedding_service.py, sentence-transformers) ưu tiên CUDA, chỉ rơi
# về CPU khi máy không có GPU, giống fashn_service.py/catvton_service.py.
# start-all.sh tự khởi động; đặt JAPANO_SKIP_EMBEDDING=1 để tắt hẳn (chỉ mất
# tín hiệu semantic cho related-products, engine gợi ý chính không ảnh hưởng).
JAPANO_EMBEDDING_URL=http://127.0.0.1:7865
JAPANO_EMBEDDING_DIR=/absolute/path/to/embedding-service
JAPANO_EMBEDDING_PYTHON=/absolute/path/to/embedding-service/.venv/bin/python
JAPANO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
JAPANO_SKIP_EMBEDDING=0

# Lưu trữ dữ liệu chính. Khi đặt MONGODB_URI, MongoDB là source of truth:
# backend không còn ghi db.json, toàn bộ dữ liệu nghiệp vụ nằm trong app_state
# và các collection theo thực thể để kiểm tra trực tiếp bằng MongoDB Compass.
# db.json chỉ là dữ liệu seed/migration khi MongoDB chưa được cấu hình.
MONGODB_URI=
MONGODB_DB=japano
CLOUDINARY_URL=

# Stripe Test Mode — tuyệt đối không đưa sk_test vào mobile hoặc commit file
# .env.server. App dùng Stripe CardField + PaymentIntent native; chỉ pk_test
# được API cấu hình trả cho SDK mobile. Refund vẫn được gọi từ Admin.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_CURRENCY=vnd
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_MERCHANT_DISPLAY_NAME="JAPANO Store"
# Tùy chọn khi dùng Stripe CLI/webhook public.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# VNPay Sandbox — điền merchant code/secret của môi trường thử nghiệm vào
# .env.server; app mở URL thanh toán trong WebView. Refund gọi qua Merchant
# WebApi (Command=refund) bên dưới.
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://japano.app/vnpay-return
# Python dùng cho YOLO pose/phụ kiện; phải có numpy, OpenCV và Ultralytics.
JAPANO_ACCESSORY_PYTHON=python3

# FASHN VTON 1.5 mặc đồ; FLUX.2 Klein 4B đổi tư thế khi ảnh khó.
JAPANO_FASHN_URL=http://127.0.0.1:7862
JAPANO_FASHN_DIR=/absolute/path/to/fashn-vton-1.5
JAPANO_FASHN_HOME=/absolute/path/to/fashn-vton-1.5
JAPANO_FASHN_WEIGHTS=/absolute/path/to/fashn-vton-1.5/weights
JAPANO_FASHN_PYTHON=/absolute/path/to/fashn-vton-1.5/.venv/bin/python
JAPANO_FLUX_REPOSE_HOME=/absolute/path/to/FLUX.2-klein-4B
JAPANO_TRYON_RUNTIME_DIR=/tmp/japano-tryon-runtime
# Profile high giữ acceptance cũ 25 bước. App mặc định gửi balanced 20 bước và
# vẫn upscale/sharpen cạnh dài 1536; fast 16 bước/1280 dành cho preview nhanh.
# Các profile chỉ giảm lượt diffusion, không chuyển inference sang CPU.
JAPANO_FASHN_STEPS=25
JAPANO_FASHN_BALANCED_STEPS=20
JAPANO_FASHN_FAST_STEPS=16
JAPANO_TRYON_FAST_LONG_EDGE=1280
JAPANO_FASHN_CFG=1.5
JAPANO_REPOSE_STEPS=4
# =0 dùng canvas FLUX 768x1024; full GPU tránh sequential CPU offload.
JAPANO_TRYON_LOW_MEMORY=0
# =1 -> nhả FASHN + FLUX khỏi VRAM ngay sau mỗi lượt, lượt sau phải nạp lại từ
# đĩa (FLUX nặng 15 GB). =0 -> giữ model lại giữa các lượt thử liên tiếp; GPU
# arbiter vẫn tự giải phóng khi người dùng rời màn hình thử đồ.
JAPANO_UNLOAD_AFTER_TRYON=0
JAPANO_TRYON_OUTPUT_LONG_EDGE=1536
JAPANO_TRYON_OUTPUT_SHARPEN=1
# Làm đẹp phụ kiện bằng FLUX.2 multi-reference sau bước ghép pose. Hệ thống tự
# đổi seed khi quality gate phát hiện che mặt/sai tay/sai trang phục. Mỗi lần
# thử lại là một lượt nạp FLUX + sinh ảnh, nên để 1 nếu cần ưu tiên tốc độ.
JAPANO_ACCESSORY_REFINE=1
JAPANO_ACCESSORY_REFINE_STEPS=4
JAPANO_ACCESSORY_REFINE_CFG=1.0
JAPANO_ACCESSORY_REFINE_ATTEMPTS=1
JAPANO_ACCESSORY_REFINE_SEED=101
JAPANO_ACCESSORY_REFINE_TIMEOUT_MS=420000
# Chỉ đổi pose khi detector thấy ảnh khó; tiết kiệm VRAM cho emulator/RDP.
JAPANO_FORCE_REPOSE=0
JAPANO_FASHN_FIDELITY_REFINE=0
JAPANO_TRYON_LOW_MEMORY=0
JAPANO_FLUX_OFFLOAD=sequential
JAPANO_UNLOAD_AFTER_TRYON=0
# Tự unload model Ollama khỏi VRAM ngay trước try-on; model không bị xóa và sẽ
# tự load lại ở request chatbot/vision tiếp theo.
JAPANO_RELEASE_OLLAMA_VRAM=1
JAPANO_TRYON_GPU_LOCK=/tmp/japano-tryon-gpu.active
JAPANO_OLLAMA_UNLOAD_TIMEOUT_SEC=30
JAPANO_MIN_GPU_FREE_GB=8
JAPANO_TRYON_AUTO_ATTEMPTS=1
# Chỉ các flat-lay đã xem thủ công và không còn da/người/nền mới được dùng.
JAPANO_APPROVED_TRYON_FLATS=kimono-hong,ao-len-cardigan,yumeko,haori-dang-dai,bikini-hoa-anh-dao

# --- Mô phỏng độ vừa vặn (fit-aware try-on) ---------------------------------
# Sau khi FASHN mặc xong trang phục, FLUX.2 dựng lại độ căng/độ rủ của vải cho
# đúng vóc dáng người mặc. =0 thì thử đồ chạy y như trước, chỉ mất hiệu ứng.
JAPANO_FIT_EFFECT_ENABLED=1
# Ngưỡng severity (0..1) để chạy lượt FLUX cho các mức lệch nhẹ. Lệch nhiều
# (very_tight/very_loose) luôn chạy bất kể ngưỡng này.
JAPANO_FIT_REFINE_MIN_SEVERITY=0.35
# Từ mức này trở lên mới cho phép mô phỏng bục/rách một đoạn đường may. Quần và
# chân váy KHÔNG bao giờ được phép có hiệu ứng này.
JAPANO_FIT_TEAR_MIN_SEVERITY=0.85
JAPANO_FIT_TEAR_ENABLED=1
JAPANO_FIT_REFINE_ATTEMPTS=2
JAPANO_FIT_REFINE_TIMEOUT_MS=420000
JAPANO_FIT_STEPS=4
JAPANO_FIT_STEPS_EXTREME=4
JAPANO_FIT_STEPS_FORCE_TEAR=5
JAPANO_FIT_LOW_MEMORY=1
JAPANO_FIT_CFG=1.0
JAPANO_FIT_SEED=77
# Trainer img2img chính thức của diffusers dùng khi huấn luyện LoRA. Script
# train_fit_lora.py chỉ kiểm tra dữ liệu/môi trường và sẽ không sinh checkpoint
# nếu chưa cấu hình trainer thật này.
JAPANO_FLUX_LORA_TRAINER=
# LoRA fit đã fine-tune (nếu có). Để trống thì dùng FLUX.2 gốc — xem
# backend/ai_training/README.md.
JAPANO_FIT_LORA_PATH=
# LoRA hiện được train trên VITON-HD (upper-body) nên CHỈ áp cho `tops`. Chỉ mở
# rộng danh sách này khi đã có validation trên đúng miền dữ liệu đó.
JAPANO_FIT_LORA_CATEGORIES=tops

# --- Môi trường fine-tune (chỉ dùng khi train, không cần khi chạy app) -------
# Venv riêng cho trainer; KHÔNG dùng chung venv inference của FASHN.
JAPANO_FIT_TRAIN_PYTHON=/home/nhat/jp/ai/flux2-fit-train/.venv/bin/python
JAPANO_FLUX_LORA_TRAINER=/home/nhat/jp/ai/diffusers-training/examples/dreambooth/train_dreambooth_lora_flux2_klein_img2img.py
JAPANO_FIT_HF_DATASET=/home/nhat/jp/datasets/japano-fit-hf
JAPANO_VITON_HD_DIR=/home/nhat/jp/datasets/viton-hd
JAPANO_FIT_TRAIN_SEED=17
JAPANO_TRAIN_LOG_DIR=/home/nhat/jp/logs

# --- An toàn cho trang phục 18+ (đồ bơi, crop top) ---------------------------
# Cổng xác nhận 18+ luôn bật và KHÔNG tắt được: mọi lượt thử đồ bơi/crop top
# bắt buộc có adultConsent=true từ client.
# Cờ dưới đây chỉ điều khiển TẦNG THỨ HAI — kiểm tra ảnh bằng model thị giác.
# Đặt 0 khi vận hành ở môi trường không có model vision; đây phải là quyết định
# có chủ đích, vì tắt đi nghĩa là chỉ còn dựa vào lời tự khai của người dùng.
JAPANO_ADULT_VISION_CHECK=1
JAPANO_ADULT_CHECK_TIMEOUT_MS=120000
JAPANO_VISION_MODEL=qwen3-vl:8b

# --- Nhận diện vóc dáng từ ảnh ----------------------------------------------
JAPANO_BODY_ANALYSIS_ENABLED=1
JAPANO_HEIGHT_ESTIMATION_ENABLED=1
JAPANO_WEIGHT_ESTIMATION_ENABLED=1
# Dưới ngưỡng tin cậy này, hệ thống trả null thay vì đoán bừa chiều cao/cân nặng.
JAPANO_BODY_ESTIMATE_MIN_CONFIDENCE=0.35
JAPANO_BODY_ANALYSIS_TIMEOUT_MS=120000
# Hằng số nhân trắc dùng để neo thang đo khi ảnh không có vật chuẩn.
JAPANO_HEAD_LENGTH_CM=23.4
JAPANO_BODY_DENSITY=1.01
# Model hồi quy cân nặng/vòng đo đã train trên ANSUR II. Trống thì dùng đường
# dẫn mặc định trong backend/ai_training/models/.
JAPANO_BODY_ESTIMATOR_MODEL=
JAPANO_BODY_GIRTH_MODEL=
# Tỉ lệ nhân trắc đã fit trên dữ liệu thật (thay bảng hằng số 1966).
JAPANO_ANTHROPOMETRY_JSON=
# CatVTON chỉ là fallback tùy chọn và mặc định TẮT. GPU 16GB không nên giữ
# CatVTON đồng thời với FASHN + FLUX.2.
JAPANO_CATVTON_URL=http://127.0.0.1:7861
JAPANO_CATVTON_DIR=/absolute/path/to/CatVTON
JAPANO_CATVTON_PYTHON=/absolute/path/to/CatVTON/.venv/bin/python
JAPANO_CATVTON_FALLBACK=0
JAPANO_SKIP_CATVTON=1
JAPANO_MOTION_URL=http://127.0.0.1:7864
JAPANO_ONE_TO_ALL_HOME=/absolute/path/to/One-to-All-Animation
JAPANO_ONE_TO_ALL_PYTHON=/absolute/path/to/One-to-All-Animation/.venv/bin/python
JAPANO_ONE_TO_ALL_CHECKPOINT=One-to-All-1.3b_1
JAPANO_MOTION_ENGINE_LABEL=one-to-all-animation-1.3b-v1
# Để trống: hệ thống tự chọn turbo cho đi bộ/tạo dáng và turn_fast cho xoay.
# Có thể ép toàn bộ request thành quality|balanced|fast|turbo để benchmark A/B.
JAPANO_MOTION_PROFILE=
# Các override dưới đây chỉ dùng khi benchmark; để trống sẽ dùng profile đã đo.
JAPANO_MOTION_FRAMES=
JAPANO_MOTION_FPS=
JAPANO_MOTION_STEPS=
JAPANO_MOTION_IMAGE_GUIDANCE=
JAPANO_MOTION_POSE_GUIDANCE=
# Gemini API video chạy cloud, luôn giữ key ở backend/.env.server và không
# đặt tiền tố EXPO_PUBLIC_. Test thủ công bằng scripts/test-gemini-video.mjs.
GEMINI_API_KEY=
JAPANO_GEMINI_VIDEO_MODEL=gemini-omni-flash-preview
JAPANO_GEMINI_VIDEO_TIMEOUT_MS=600000
# Các cờ dưới đây chỉ được start-all.sh đọc.
JAPANO_SKIP_FASHN=0
JAPANO_SKIP_MOTION=0
JAPANO_AI_GATEWAY_URL=http://127.0.0.1:8001
JAPANO_OLLAMA_URL=http://127.0.0.1:11434
JAPANO_OLLAMA_MODEL=qwen2.5:7b
# Mặc định tắt để chatbot không tự thêm tên sản phẩm ngoài catalog.
JAPANO_OLLAMA_CHAT=0
JAPANO_VISION_MODEL=qwen3-vl:8b
JAPANO_VISION_TIMEOUT_MS=120000
JAPANO_GOALS_MODEL=qwen2.5:7b
JAPANO_GOALS_LLM=1
JAPANO_GOALS_TIMEOUT_MS=90000
JAPANO_CATVTON_DISABLE=0
JAPANO_TRYON_TIMEOUT_MS=900000

# Mobile: Android emulator dùng 10.0.2.2; start-all.sh sẽ tự đặt URL và adb reverse.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4100
EXPO_PUBLIC_API_PORT=4100

# --- Đường app tìm tới backend -------------------------------------------
# App dò lần lượt từ đường ngắn nhất tới đường xa nhất và dừng ở đường đầu tiên
# trả lời được, nên có thể khai báo cả ba mà không cần build lại khi đổi chỗ:
#
#   1. Cắm dây USB   -> http://127.0.0.1:<cổng>, nhờ `adb reverse tcp:4100 tcp:4100`
#   2. Cùng mạng Wi-Fi -> EXPO_PUBLIC_API_LAN_URL
#   3. Ở xa           -> EXPO_PUBLIC_API_TAILSCALE_URL (chỉ khi hai đường trên hỏng)
#
# Đặt EXPO_PUBLIC_API_URL sẽ GHI ĐÈ toàn bộ thứ tự trên — chỉ dùng khi cần ghim
# cứng một địa chỉ.
EXPO_PUBLIC_API_LAN_URL=
EXPO_PUBLIC_API_TAILSCALE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=20000
EXPO_PUBLIC_TRYON_TIMEOUT_MS=720000

# Script kiểm tra API (npm run verify / npm run verify:ai).
JAPANO_API_URL=http://127.0.0.1:4100

# ---------------------------------------------------------------------------
# EMAIL THẬT (SMTP)
# ---------------------------------------------------------------------------
# Bỏ trống SMTP_HOST => dùng hộp thư giả lập Ethereal: email vẫn gửi và xem lại
# được qua link preview, nhưng KHÔNG tới hộp thư ngoài đời.
# Với Gmail: bật xác thực 2 bước, rồi tạo "App Password" 16 ký tự tại
# https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thường.
# Kiểm tra cấu hình:  npm run mail:test -- ban@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM='JAPANO <no-reply@japano.vn>'

# Gộp các lần đăng nhập liên tiếp của cùng một tài khoản (ms). 0 = gửi mọi lần.
JAPANO_LOGIN_ALERT_MIN_INTERVAL_MS=0

# ---------------------------------------------------------------------------
# ĐĂNG NHẬP BẰNG GOOGLE
# ---------------------------------------------------------------------------
# Tạo OAuth Client ID tại https://console.cloud.google.com/apis/credentials
#   · Android : cần package name "vn.japano.app" + dấu vân tay SHA-1
#   · Web     : dùng khi chạy trên trình duyệt / Expo Go
# Backend đối chiếu các id này với "aud" trong token Google, nên tất cả client
# id đang dùng đều phải liệt kê ở đây, nếu không sẽ bị từ chối đăng nhập.
# Cùng bộ giá trị này phải điền vào mobile/app.json → extra.google.*
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# ---------------------------------------------------------------------------
# BẢO MẬT KHI TRIỂN KHAI THẬT
# ---------------------------------------------------------------------------
# Bỏ trống = cho phép mọi origin (tiện cho dev/demo). Khi deploy nên giới hạn.
JAPANO_ALLOWED_ORIGINS=
