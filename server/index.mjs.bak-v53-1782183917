function toStringList(value) {
  if (Array.isArray(value)) return value.map((x) => String(x || '').trim()).filter(Boolean);
  return String(value || '').split(/[\n,;]+/).map((x) => x.trim()).filter(Boolean);
}

function uniqueStrings(values = []) {
  const seen = new Set();
  return values.map((x) => String(x || '').trim()).filter((x) => {
    if (!x || seen.has(x)) return false;
    seen.add(x);
    return true;
  });
}

function normalizeProductImages(input = {}) {
  const raw = uniqueStrings([
    input.image,
    input.imageUrl,
    input.url,
    input.image1,
    ...(Array.isArray(input.images) ? input.images : toStringList(input.images)),
    input.image2,
    input.image3,
    input.image4,
  ]);
  const seed = raw.join('|') || String(input.id || input.productId || input.name || 'japano');
  let offset = crypto.createHash('md5').update(seed).digest()[0] || 0;
  while (raw.length < 4) {
    raw.push(DEFAULT_PRODUCT_IMAGE_POOL[offset % DEFAULT_PRODUCT_IMAGE_POOL.length]);
    offset += 1;
  }
  return uniqueStrings(raw).slice(0, 4);
}

function normalizeSizes(input = {}) {
  const sizes = uniqueStrings([
    ...toStringList(input.sizes),
    ...toStringList(input.size),
    ...toStringList(input.availableSizes),
    ...toStringList(input.kichCo),
  ]);
  return sizes.length ? sizes.slice(0, 12) : ['S', 'M', 'L', 'XL'];
}

function normalizeColors(input = {}) {
