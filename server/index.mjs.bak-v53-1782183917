  const customerTrends = [...categoryTrendMap.values()].map((row) => ({ ...row, score: row.sold * 3 + row.wishlists * 2 + row.carts })).sort((a, b) => b.score - a.score).slice(0, 8);

  return {
    kpis: {
      revenueTotal,
      monthRevenue,
      avgOrderValue,
      orders: orders.length,
      users: users.length,
      newUsersThisMonth: users.filter((u) => monthKey(u.createdAt) === startMonth).length,
      products: products.length,
      conversionSignal: carts.length + wishlists.length ? Math.round((orders.length / Math.max(1, carts.length + wishlists.length)) * 100) : 0,
    },
    revenueByMonth: [...revenueMap.entries()].map(([label, value]) => ({ label, value })),
