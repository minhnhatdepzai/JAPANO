    Cart.find({}).limit(2000).lean().catch(() => []),
    Wishlist.find({}).limit(2000).lean().catch(() => []),
    Review.find({}).limit(2000).lean().catch(() => []),
    AIChat.find({}).sort({ createdAt: -1 }).limit(500).lean().catch(() => []),
  ]);

  const paidOrders = orders.filter((o) => ['paid', 'delivered', 'shipping', 'completed'].includes(String(o.paymentStatus || o.status || '').toLowerCase()) || toNumber(o.total || o.totalAmount, 0) > 0);
  const revenueTotal = paidOrders.reduce((sum, order) => sum + toNumber(order.total ?? order.totalAmount, 0), 0);
  const avgOrderValue = orders.length ? revenueTotal / Math.max(1, orders.length) : 0;
  const now = new Date();
  const startMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  const monthRevenue = orders.filter((o) => monthKey(o.orderDate || o.createdAt) === startMonth).reduce((sum, order) => sum + toNumber(order.total ?? order.totalAmount, 0), 0);
  const revenueMap = new Map();
  for (let i = 5; i >= 0; i -= 1) {
    const d = new Date(Date.UTC(now.getFullYear(), now.getMonth() - i, 1));
    revenueMap.set(d.toISOString().slice(0, 7), 0);
  }
  for (const order of orders) {
    const key = monthKey(order.orderDate || order.createdAt);
    if (revenueMap.has(key)) revenueMap.set(key, revenueMap.get(key) + toNumber(order.total ?? order.totalAmount, 0));
  }

  const productById = new Map(products.map((p) => [String(p.id || p._id), p]));
  const salesMap = new Map();
  for (const item of orderItems) {
    const productId = String(item.productId || item.productSnapshot?.id || 'unknown');
    const snapshot = item.productSnapshot || productById.get(productId) || {};
    const current = salesMap.get(productId) || { productId, name: snapshot.name || snapshot.productName || 'Sáº£n pháº©m', image: snapshot.image || '', unitsSold: 0, revenue: 0 };
    const qty = Math.max(1, toNumber(item.quantity, 1));
    current.unitsSold += qty;
    current.revenue += qty * toNumber(item.unitPrice ?? snapshot.price, 0);
    salesMap.set(productId, current);
  }
  const salesByProduct = [...salesMap.values()].sort((a, b) => b.unitsSold - a.unitsSold).slice(0, 8);

  const cartCounts = new Map();
  const wishlistCounts = new Map();
  for (const row of carts) cartCounts.set(String(row.productId), (cartCounts.get(String(row.productId)) || 0) + Math.max(1, toNumber(row.quantity, 1)));
  for (const row of wishlists) wishlistCounts.set(String(row.productId), (wishlistCounts.get(String(row.productId)) || 0) + 1);
  const reviewStats = new Map();
  for (const review of reviews) {
    const orderItem = orderItems.find((row) => String(row._id) === String(review.orderItemId));
    const productId = String(orderItem?.productId || '');
    if (!productId) continue;
    const stat = reviewStats.get(productId) || { count: 0, rating: 0 };
    stat.count += 1;
    stat.rating += toNumber(review.rating, 0);
    reviewStats.set(productId, stat);
  }
  const chatText = chats.map((c) => String(c.content || '').toLowerCase()).join(' ');
  const chatMention = new Map();
  for (const product of products) {
    const key = String(product.id || '');
    const terms = [product.name, product.productName, product.category].filter(Boolean).map((v) => String(v).toLowerCase());
    const mentions = terms.reduce((sum, term) => sum + (term && chatText.includes(term) ? 1 : 0), 0);
    if (mentions) chatMention.set(key, mentions);
  }
  const maxUnits = Math.max(1, ...salesByProduct.map((x) => x.unitsSold || 0));
  const maxWishlist = Math.max(1, ...wishlistCounts.values(), 1);
  const maxCart = Math.max(1, ...cartCounts.values(), 1);
  const maxMention = Math.max(1, ...chatMention.values(), 1);

  const predictions = products.map((p) => {
