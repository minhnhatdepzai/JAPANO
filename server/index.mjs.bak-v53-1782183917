      let s = 0;
      for (const tag of (mainProduct.visualTags || [])) if (t.includes(String(tag).toLowerCase())) s += 2;
      for (const tag of (visual?.visualTags || [])) if (t.includes(String(tag).toLowerCase())) s += 2;
