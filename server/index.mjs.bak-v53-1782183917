    const recommended = [
      ...items.filter((p) => !v45IsAccessory(p)).slice(0, 8),
      ...items.filter((p) => v45IsAccessory(p)).slice(0, 8),
    ];
    res.json({ ok: true, count: items.length, items, recommended });
  } catch (e) {
