    const ratingStat = reviewStats.get(productId) || { count: 0, rating: 0 };
    const avgRating = ratingStat.count ? ratingStat.rating / ratingStat.count : 4;
    const daysOld = Math.max(0, (Date.now() - new Date(p.createdAt || Date.now()).getTime()) / 86400000);
    const recency = Math.max(0, 1 - Math.min(daysOld, 90) / 90);
    const mention = chatMention.get(productId) || 0;
    const score = (
      0.35 * (sold / maxUnits) +
      0.20 * (wishlist / maxWishlist) +
      0.15 * (cart / maxCart) +
      0.15 * (avgRating / 5) +
      0.10 * recency +
      0.05 * (mention / maxMention)
    );
    return {
      productId,
      name: p.name || p.productName,
      image: p.image || '',
      category: p.category || 'general',
      price: toNumber(p.price, 0),
      score: toPercent(score * 100),
      predictedDemand: score >= 0.72 ? 'Ráº¥t dá»… bÃ¡n cháº¡y' : score >= 0.52 ? 'CÃ³ tiá»m nÄƒng' : score >= 0.34 ? 'Cáº§n Ä‘áº©y marketing' : 'Nhu cáº§u tháº¥p',
      features: { sold, wishlist, cart, avgRating: Math.round(avgRating * 10) / 10, chatMention: mention },
      suggestion: score >= 0.52 ? 'NÃªn tÄƒng hiá»ƒn thá»‹ á»Ÿ home, flash sale hoáº·c banner.' : 'NÃªn chá»‰nh áº£nh/mÃ´ táº£ hoáº·c táº¡o voucher Ä‘á»ƒ test nhu cáº§u.',
    };
  }).sort((a, b) => b.score - a.score).slice(0, 8);

  const categoryTrendMap = new Map();
  for (const p of products) categoryTrendMap.set(p.category || 'general', { category: p.category || 'general', productCount: 0, sold: 0, wishlists: 0, carts: 0, score: 0 });
  for (const p of products) {
