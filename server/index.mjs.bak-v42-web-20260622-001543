function makeMemoryQuery(executor) {
  const state = { sortSpec: null, limitN: null, leanMode: false };
  const run = async () => {
    let result = typeof executor === 'function' ? await executor() : executor;
    if (Array.isArray(result)) {
      result = [...result];
      if (state.sortSpec) {
        const entries = Object.entries(state.sortSpec);
        result.sort((a, b) => {
          for (const [key, direction] of entries) {
            const av = a?.[key] instanceof Date ? a[key].getTime() : a?.[key];
            const bv = b?.[key] instanceof Date ? b[key].getTime() : b?.[key];
            if (av === bv) continue;
            return (av > bv ? 1 : -1) * (Number(direction) < 0 ? -1 : 1);
          }
          return 0;
        });
      }
      if (Number.isFinite(state.limitN)) result = result.slice(0, state.limitN);
      return state.leanMode ? result.map((item) => ({ ...item })) : result;
    }
    return state.leanMode && result ? { ...result } : result;
  };
  return {
    sort(spec) { state.sortSpec = spec || null; return this; },
    limit(n) { state.limitN = Number(n); return this; },
    lean() { state.leanMode = true; return this; },
    then(resolve, reject) { return run().then(resolve, reject); },
    catch(reject) { return run().catch(reject); },
  };
}

function createMemoryModel(name) {
  const rows = [];
  const nowIso = () => new Date();
  const normalizeId = (value) => String(value || '');
  const matches = (doc, filter = {}) => Object.entries(filter || {}).every(([key, expected]) => {
    const actual = key === '_id' ? doc._id : doc[key];
    if (expected instanceof RegExp) return expected.test(String(actual || ''));
    if (expected && typeof expected === 'object' && !(expected instanceof Date) && !Buffer.isBuffer(expected)) {
      if ('$ne' in expected) return String(actual) !== String(expected.$ne);
      if ('$in' in expected) return expected.$in.map(String).includes(String(actual));
    }
    return String(actual ?? '') === String(expected ?? '');
  });
  const applyPatch = (doc, patch = {}) => {
    const clean = patch?.$set ? patch.$set : patch;
    Object.assign(doc, clean || {}, { updatedAt: nowIso() });
    return doc;
  };
  return {
    __memoryOnly: true,
    modelName: name,
    async create(input = {}) {
      const doc = {
        ...input,
        _id: input._id || crypto.randomBytes(12).toString('hex'),
        createdAt: input.createdAt || nowIso(),
        updatedAt: input.updatedAt || nowIso(),
      };
      rows.push(doc);
      return doc;
    },
    find(filter = {}) {
      return makeMemoryQuery(() => rows.filter((doc) => matches(doc, filter)));
    },
    findOne(filter = {}) {
      return makeMemoryQuery(() => rows.find((doc) => matches(doc, filter)) || null);
    },
    findById(id) {
      return makeMemoryQuery(() => rows.find((doc) => normalizeId(doc._id) === normalizeId(id)) || null);
    },
    findOneAndUpdate(filter = {}, patch = {}, options = {}) {
      return makeMemoryQuery(async () => {
        let doc = rows.find((item) => matches(item, filter));
        if (!doc && options.upsert) {
          doc = { ...filter, _id: crypto.randomBytes(12).toString('hex'), createdAt: nowIso(), updatedAt: nowIso() };
          rows.push(doc);
        }
        if (doc) applyPatch(doc, patch);
        return doc || null;
      });
    },
    async deleteOne(filter = {}) {
      const index = rows.findIndex((doc) => matches(doc, filter));
      if (index >= 0) rows.splice(index, 1);
      return { acknowledged: true, deletedCount: index >= 0 ? 1 : 0 };
    },
    async deleteMany(filter = {}) {
      let deletedCount = 0;
      for (let i = rows.length - 1; i >= 0; i -= 1) {
        if (matches(rows[i], filter)) { rows.splice(i, 1); deletedCount += 1; }
      }
      return { acknowledged: true, deletedCount };
    },
    async insertMany(items = []) {
      const created = [];
      for (const item of items) created.push(await this.create(item));
      return created;
    },
    _rows: rows,
  };
}

