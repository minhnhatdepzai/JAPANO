{
  "name": "appne",
  "version": "1.0.26",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "reset-project": "node ./scripts/reset-project.js",
    "start-server": "node server/index.mjs",
    "dev:full": "concurrently \"npm run start-server\" \"npx expo start\"",
    "expo-go": "expo start -c --host lan",
    "setup:node": "npm install --legacy-peer-deps --no-audit --no-fund --prefer-online",
    "setup:python": "python -m pip install --upgrade pip setuptools wheel && pip install -r server/vision-requirements.txt",
    "run:backend": "node server/index.mjs",
    "run:expo-go": "expo start -c --host lan",
    "dev-client": "expo start --dev-client --host lan",
    "dev-client:clear": "expo start --dev-client --host lan -c",
    "eas:android:dev": "eas build --platform android --profile development",
    "eas:android:preview": "eas build --platform android --profile preview",
    "eas:ios:dev": "eas build --platform ios --profile development",
    "mongo:clean-erd": "node scripts/clean-mongo-erd-only.mjs",
    "web:clear": "expo start --web -c"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "axios": "^1.7.9",
    "cloudinary": "^2.5.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.8",
    "express": "^4.21.2",
    "firebase": "^12.6.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
