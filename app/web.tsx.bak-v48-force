  .grid{max-width:1280px;margin:0 auto;padding:18px;display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.span8{grid-column:span 8}.span4{grid-column:span 4}.span6{grid-column:span 6}.span12{grid-column:span 12}
  .products{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}.product{background:#fff;border:1px solid #fce7f3;border-radius:22px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.06)}
  .product img{width:100%;height:210px;object-fit:cover;background:#f3f4f6}.product .pbody{padding:12px}.product h3{font-size:15px;margin:0 0 6px}.price{font-weight:900;color:#be185d}
  input,textarea,select{width:100%;border:1px solid #f9a8d4;background:#fff;border-radius:16px;padding:12px 13px;outline:none;font-size:14px}
  label{font-size:13px;font-weight:800;color:#831843;display:block;margin:10px 0 6px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.preview{display:flex;gap:10px;flex-wrap:wrap}.preview img{width:130px;height:170px;object-fit:cover;border-radius:16px;border:1px solid #fbcfe8;background:#f8fafc}
  video{width:100%;border-radius:22px;background:#111;min-height:260px}.result{white-space:pre-wrap;background:#fff7ed;border:1px solid #fed7aa;border-radius:18px;padding:12px;color:#7c2d12}
  .modal{position:fixed;inset:0;background:rgba(0,0,0,.46);z-index:99;display:flex;align-items:center;justify-content:center;padding:18px}.modalCard{max-width:920px;width:100%;max-height:92vh;overflow:auto;background:white;border-radius:28px;padding:18px}
  .modalGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:18px}.modalGrid img{width:100%;height:480px;object-fit:cover;border-radius:22px}.danger{color:#be123c;font-weight:800}.ok{color:#047857;font-weight:900}
  @media(max-width:900px){.hero,.modalGrid{grid-template-columns:1fr}.span8,.span4,.span6{grid-column:span 12}.title{font-size:32px}.row{grid-template-columns:1fr}}
  `;
}

export default function JapanoWebV43() {
  const [products, setProducts] = useState<any[]>([]);
  const [query, setQuery] = useState('');
  const [selected, setSelected] = useState<any | null>(null);
  const [cart, setCart] = useState<any[]>([]);
  const [wishlist, setWishlist] = useState<any[]>([]);
  const [log, setLog] = useState('Sẵn sàng.');
  const [loading, setLoading] = useState(false);

  const [personUrl, setPersonUrl] = useState('');
  const [personB64, setPersonB64] = useState('');
  const [garmentUrl, setGarmentUrl] = useState('');
  const [garmentB64, setGarmentB64] = useState('');
  const [accessoryLinks, setAccessoryLinks] = useState('');
  const [adultConfirmed, setAdultConfirmed] = useState(true);
  const [tryResult, setTryResult] = useState<any>(null);

  const [cameraUrl, setCameraUrl] = useState('');
  const [cameraFrame, setCameraFrame] = useState('');
  const [cameraResult, setCameraResult] = useState<any>(null);
  const [webcamOn, setWebcamOn] = useState(false);
  const videoRef = useRef<any>(null);
  const streamRef = useRef<any>(null);

  async function loadProducts() {
    try {
      const data = await api('/api/v43/web/products');
      setProducts(data.items || []);
      setLog(`Đã tải ${data.count || data.items?.length || 0} sản phẩm.`);
    } catch (e: any) {
      setLog(`Lỗi tải sản phẩm: ${e.message}`);
    }
  }

  async function seedProducts() {
    setLoading(true);
    try {
      const data = await api('/api/v43/web/seed-products', { method: 'POST', body: JSON.stringify({}) });
      setProducts(data.items || []);
      setLog(`Đã seed sản phẩm V43. Tổng: ${data.count || 0}`);
    } catch (e: any) {
      setLog(`Seed lỗi: ${e.message}`);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { loadProducts(); }, []);

  const filtered = useMemo(() => {
    const q = query.toLowerCase().trim();
    if (!q) return products;
    return products.filter((p) => `${p.name} ${p.category} ${p.subcategory} ${p.description} ${(p.visualTags || []).join(' ')}`.toLowerCase().includes(q));
  }, [products, query]);

  async function pickFile(kind: 'person' | 'garment' | 'camera') {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = async () => {
      const file = input.files?.[0];
      if (!file) return;
      const dataUrl = await fileToDataUrl(file);
      if (kind === 'person') setPersonB64(dataUrl);
      if (kind === 'garment') setGarmentB64(dataUrl);
      if (kind === 'camera') setCameraFrame(dataUrl);
      setLog(`Đã chọn ảnh ${kind}: ${file.name}`);
    };
    input.click();
  }

  async function runTryOn(product = selected) {
    setLoading(true);
    setTryResult(null);
    try {
      const body = {
        adultConfirmed,
        personImageUrl: personB64 ? '' : personUrl,
        personImageBase64: personB64,
        garmentImageUrl: garmentB64 ? '' : (garmentUrl || product?.image || ''),
        garmentImageBase64: garmentB64,
        accessoryImageUrls: splitLinks(accessoryLinks),
        product,
        productName: product?.name || 'JAPANO outfit',
        category: product?.subcategory || product?.category || 'fashion',
        prompt: 'web try-on V43, realistic fashion, preserve natural pose',
        allowGenerateFallback: true,
      };
      const data = await api('/api/v43/web/tryon', { method: 'POST', body: JSON.stringify(body) });
      setTryResult(data);
      setLog(data.message || 'Đã chạy try-on.');
    } catch (e: any) {
      setLog(`Try-on lỗi: ${e.message}`);
    } finally {
      setLoading(false);
    }
  }

  async function startWebcam() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 960, height: 720 }, audio: false });
      streamRef.current = stream;
      setWebcamOn(true);
      setTimeout(() => {
        if (videoRef.current) videoRef.current.srcObject = stream;
      }, 50);
      setLog('Webcam đã bật. Nếu trình duyệt hỏi quyền camera, bấm Allow.');
    } catch (e: any) {
      setLog(`Không mở được webcam: ${e.message}. Hãy kiểm tra quyền Camera trong Windows/Chrome.`);
    }
  }

  function stopWebcam() {
    streamRef.current?.getTracks?.().forEach((t: any) => t.stop());
    streamRef.current = null;
    setWebcamOn(false);
  }

  function captureFrame() {
    const video = videoRef.current;
    if (!video) return '';
    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth || 720;
    canvas.height = video.videoHeight || 540;
    const ctx = canvas.getContext('2d');
    ctx?.drawImage(video, 0, 0, canvas.width, canvas.height);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.88);
    setCameraFrame(dataUrl);
    return dataUrl;
  }

  async function analyzeCamera(useCapture = false) {
    setLoading(true);
    try {
      const frame = useCapture ? captureFrame() : cameraFrame;
      const body = {
        adultConfirmed,
        imageUrl: frame ? '' : cameraUrl,
        imageBase64: frame,
        profile: { purpose: 'web camera stylist', requested: ['emotion', 'ageGroup', 'style', 'products'] },
      };
      const data = await api('/api/v43/web/camera-analyze', { method: 'POST', body: JSON.stringify(body) });
      setCameraResult(data);
      setLog('Đã phân tích webcam/link ảnh và gợi ý sản phẩm.');
    } catch (e: any) {
      setLog(`Camera analyze lỗi: ${e.message}`);
    } finally {
      setLoading(false);
    }
  }

  const sampleProduct = selected || products[0];

  return (
    <div className="page">
      <style>{css()}</style>
      <div className="top">
        <div className="bar">
          <div className="brand">JAPANO Web AI Studio V43</div>
          <div className="nav">
            <button className="secondary" onClick={() => document.getElementById('products')?.scrollIntoView({ behavior: 'smooth' })}>Sản phẩm</button>
            <button className="secondary" onClick={() => document.getElementById('tryon')?.scrollIntoView({ behavior: 'smooth' })}>Thử đồ</button>
            <button className="secondary" onClick={() => document.getElementById('camera')?.scrollIntoView({ behavior: 'smooth' })}>Webcam AI</button>
            <button onClick={seedProducts} disabled={loading}>Seed sản phẩm</button>
          </div>
        </div>
      </div>

      <section className="hero">
        <div className="card">
          <span className="pill">Web giống Android</span>
          <span className="pill">Chọn ảnh / Link ảnh / Webcam</span>
          <span className="pill">Emotion + Age group + Style</span>
          <h1 className="title">JAPANO AI Fashion Assistant trên Web</h1>
          <p className="muted">
            Trang này dùng chung backend <b>{API_BASE}</b>, hỗ trợ sản phẩm, thử đồ bằng link ảnh/file/webcam,
            phân tích camera để gợi ý phong cách, size và phụ kiện.
          </p>
          <p className="result">{log}</p>
        </div>
        <div className="card">
          <h2>Trạng thái nhanh</h2>
          <p className="muted">Sản phẩm: <b>{products.length}</b></p>
          <p className="muted">Giỏ web tạm: <b>{cart.length}</b> món</p>
          <p className="muted">Yêu thích web tạm: <b>{wishlist.length}</b> món</p>
          <p className="danger">Emotion/age chỉ là ước lượng model ảnh, không dùng để xác minh danh tính/tuổi thật.</p>
        </div>
      </section>

      <main className="grid">
        <section id="products" className="card span8">
          <h2>Trang sản phẩm Web</h2>
          <div className="row">
            <input value={query} onChange={(e: any) => setQuery(e.target.value)} placeholder="Tìm crop top, bikini, dây chuyền, đồng hồ..." />
            <button onClick={loadProducts}>Tải lại sản phẩm</button>
          </div>
          <br />
          <div className="products">
            {filtered.map((p) => (
              <div className="product" key={p.id || p._id || p.name}>
                <img src={p.image || p.images?.[0] || 'https://placehold.co/600x800/fdf2f8/be185d?text=JAPANO'} />
                <div className="pbody">
                  <h3>{p.name}</h3>
                  <div className="price">{money(p.price)}</div>
                  <div className="muted">{p.subcategory || p.category}</div>
                  <div style={{ display: 'flex', gap: 6, marginTop: 10, flexWrap: 'wrap' }}>
                    <button className="secondary" onClick={() => setSelected(p)}>Xem</button>
                    <button onClick={() => { setSelected(p); setGarmentUrl(p.image || ''); document.getElementById('tryon')?.scrollIntoView({ behavior: 'smooth' }); }}>Thử</button>
                    <button className="dark" onClick={() => setCart((x) => [...x, p])}>Giỏ</button>
                    <button className="secondary" onClick={() => setWishlist((x) => [...x, p])}>♥</button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <aside className="card span4">
          <h2>Sản phẩm đang chọn</h2>
          {sampleProduct ? (
            <>
              <img src={sampleProduct.image} style={{ width: '100%', borderRadius: 22, maxHeight: 360, objectFit: 'cover' }} />
              <h3>{sampleProduct.name}</h3>
              <p className="price">{money(sampleProduct.price)}</p>
              <p className="muted">{sampleProduct.description}</p>
              <button onClick={() => setSelected(sampleProduct)}>Mở chi tiết</button>
            </>
          ) : <p>Chưa có sản phẩm. Bấm Seed sản phẩm.</p>}
        </aside>

        <section id="tryon" className="card span6">
          <h2>Thử đồ Web: chọn ảnh / dán link / dùng sản phẩm</h2>
          <label>Ảnh người - dán link</label>
          <input value={personUrl} onChange={(e: any) => { setPersonUrl(e.target.value); setPersonB64(''); }} placeholder="https://... ảnh người" />
          <div style={{ marginTop: 8 }}>
            <button className="secondary" onClick={() => pickFile('person')}>Chọn ảnh người từ máy</button>
            <button className="secondary" onClick={() => { const f = captureFrame(); if (f) setPersonB64(f); }}>Lấy ảnh từ webcam</button>
          </div>

          <label>Ảnh sản phẩm - dán link hoặc chọn sản phẩm bên trên</label>
          <input value={garmentUrl} onChange={(e: any) => { setGarmentUrl(e.target.value); setGarmentB64(''); }} placeholder="https://... ảnh áo/quần/bikini/phụ kiện" />
          <div style={{ marginTop: 8 }}>
            <button className="secondary" onClick={() => pickFile('garment')}>Chọn ảnh sản phẩm từ máy</button>
            <button className="secondary" onClick={() => sampleProduct && setGarmentUrl(sampleProduct.image || '')}>Dùng sản phẩm đang chọn</button>
          </div>

          <label>Nhiều link phụ kiện, mỗi dòng 1 link</label>
          <textarea rows={4} value={accessoryLinks} onChange={(e: any) => setAccessoryLinks(e.target.value)} placeholder="https://... dây chuyền&#10;https://... đồng hồ&#10;https://... kính/túi" />

          <label><input type="checkbox" checked={adultConfirmed} onChange={(e: any) => setAdultConfirmed(e.target.checked)} style={{ width: 'auto', marginRight: 8 }} />Xác nhận chế độ adult fashion nếu dùng bikini/đồ bơi/crop-top</label>
          <button onClick={() => runTryOn(sampleProduct)} disabled={loading}>Tạo thử đồ Web</button>

          <h3>Preview input</h3>
          <div className="preview">
            {(personB64 || personUrl) && <img src={personB64 || personUrl} />}
            {(garmentB64 || garmentUrl || sampleProduct?.image) && <img src={garmentB64 || garmentUrl || sampleProduct?.image} />}
            {splitLinks(accessoryLinks).slice(0, 4).map((x) => <img key={x} src={x} />)}
          </div>

          {tryResult && (
            <>
              <h3>Kết quả try-on</h3>
              <p className="result">{tryResult.message}</p>
              {tryResult.imageBase64 ? <img src={`data:image/png;base64,${tryResult.imageBase64}`} style={{ width: '100%', borderRadius: 22 }} /> : null}
              {!tryResult.imageBase64 && (
                <div className="preview">
                  {tryResult.sourcePersonImageBase64 && <img src={tryResult.sourcePersonImageBase64} />}
                  {tryResult.sourceGarmentImageBase64 && <img src={tryResult.sourceGarmentImageBase64} />}
                </div>
              )}
            </>
          )}
        </section>

        <section id="camera" className="card span6">
          <h2>Camera real-time Web AI Stylist</h2>
          <p className="muted">Webcam trên web dùng camera máy tính trực tiếp, không phụ thuộc camera máy ảo Android.</p>
          {!webcamOn ? <button onClick={startWebcam}>Bật webcam máy tính</button> : <button className="dark" onClick={stopWebcam}>Tắt webcam</button>}
          <br /><br />
          <video ref={videoRef} autoPlay muted playsInline />
          <div style={{ display: 'flex', gap: 8, marginTop: 10, flexWrap: 'wrap' }}>
            <button onClick={() => analyzeCamera(true)} disabled={loading || !webcamOn}>Chụp webcam & phân tích</button>
            <button className="secondary" onClick={() => pickFile('camera')}>Chọn ảnh để phân tích</button>
          </div>

          <label>Hoặc dán link ảnh để phân tích</label>
          <input value={cameraUrl} onChange={(e: any) => { setCameraUrl(e.target.value); setCameraFrame(''); }} placeholder="https://... ảnh outfit/người mẫu/sản phẩm" />
          <button style={{ marginTop: 8 }} onClick={() => analyzeCamera(false)} disabled={loading}>Phân tích bằng link/ảnh đã chọn</button>

          {cameraFrame && (
            <>
              <h3>Frame đã chụp/chọn</h3>
              <img src={cameraFrame} style={{ width: '100%', maxHeight: 360, objectFit: 'cover', borderRadius: 22 }} />
            </>
          )}

          {cameraResult && (
            <>
              <h3>Kết quả nhận diện</h3>
              <div className="result">
                {`Khuôn mặt: ${cameraResult.face?.faceCount ?? 0}
Biểu cảm: ${cameraResult.face?.primaryEmotion || 'unknown'}
Nhóm tuổi ước lượng: ${cameraResult.face?.ageGroup || 'unknown'}
Tóm tắt style: ${cameraResult.style?.summary || ''}
Tag: ${(cameraResult.style?.styleTags || []).join(', ')}
Gợi ý phụ kiện: ${(cameraResult.style?.accessoryAdvice || []).join(' | ')}
Câu hỏi size: ${(cameraResult.style?.sizeQuestions || []).join(' | ')}`}
              </div>
              <h3>Sản phẩm AI gợi ý</h3>
              <div className="products">
                {(cameraResult.products || []).slice(0, 6).map((p: any) => (
                  <div className="product" key={p.id || p.name}>
                    <img src={p.image} />
                    <div className="pbody">
                      <h3>{p.name}</h3>
                      <div className="price">{money(p.price)}</div>
                      <button onClick={() => { setSelected(p); setGarmentUrl(p.image || ''); document.getElementById('tryon')?.scrollIntoView({ behavior: 'smooth' }); }}>Thử món này</button>
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}
        </section>

        <section className="card span12">
          <h2>Giỏ hàng / yêu thích web tạm</h2>
          <p className="muted">Bản web này giữ giỏ/yêu thích tạm trong phiên để test UI nhanh. Khi cần đồng bộ tài khoản, nối lại API cart/wishlist gốc.</p>
          <p><b>Giỏ:</b> {cart.map((x) => x.name).join(', ') || 'trống'}</p>
          <p><b>Yêu thích:</b> {wishlist.map((x) => x.name).join(', ') || 'trống'}</p>
        </section>
      </main>

      {selected && (
        <div className="modal" onClick={() => setSelected(null)}>
          <div className="modalCard" onClick={(e) => e.stopPropagation()}>
            <div className="modalGrid">
              <img src={selected.image} />
              <div>
                <button className="secondary" style={{ float: 'right' }} onClick={() => setSelected(null)}>Đóng</button>
                <h2>{selected.name}</h2>
                <p className="price">{money(selected.price)}</p>
                <p className="muted">{selected.description}</p>
                <p><b>Size:</b> {(selected.sizes || []).join(', ') || 'Free size'}</p>
                <p><b>Màu:</b> {(selected.colors || []).join(', ') || 'Đang cập nhật'}</p>
                <p><b>Form:</b> {selected.fit || 'regular'}</p>
                <p><b>Tag:</b> {(selected.visualTags || []).join(', ')}</p>
                <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                  <button onClick={() => { setGarmentUrl(selected.image || ''); setSelected(selected); document.getElementById('tryon')?.scrollIntoView({ behavior: 'smooth' }); }}>Thử đồ với món này</button>
                  <button className="dark" onClick={() => setCart((x) => [...x, selected])}>Thêm giỏ</button>
                  <button className="secondary" onClick={() => setWishlist((x) => [...x, selected])}>Thêm yêu thích</button>
                </div>
                <p className="danger">Với bikini/đồ bơi/crop-top: chỉ dùng chế độ adult fashion hợp lệ. AI sẽ giữ đúng form sản phẩm, không tự thêm che phủ nếu bạn bật xác nhận người lớn.</p>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
