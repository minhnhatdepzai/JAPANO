import React, { useEffect, useMemo, useState } from 'react';
import { ActivityIndicator, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { Stack, router, useLocalSearchParams } from 'expo-router';
import { goBackOrReplace } from '../../lib/navigation';
import { Feather } from '@expo/vector-icons';
import { getProduct, Product, products } from '../../data/catalog';
import { ProductCard } from '../../components/ProductCard';
import { SafeImage } from '../../components/SafeImage';
import { useApp } from '../../context/AppContext';
import { cardStyle, fontFamily, radius, scaleFont, shadow } from '../../lib/styles';
import { api } from '../../lib/api';
import { getOutfitSuggestions, OutfitSuggestion } from '../../data/styleSuggestions';

export default function ProductDetail() {
  const { id } = useLocalSearchParams<{ id: string }>();
  const product = getProduct(id || '') || products[0];
  const { theme, formatCurrency, addToCart, toggleWishlist, wishlist, user } = useApp();
  const liked = wishlist.some((p) => p.id === product.id);
  const originalPrice = Number((product as any).originalPrice || 0);
  const hasDiscount = originalPrice > Number(product.price || 0);
  const discountPercent = Number((product as any).discountPercent || (hasDiscount ? Math.round((1 - Number(product.price || 0) / originalPrice) * 100) : 0));
  const [aiLoading, setAiLoading] = useState(false);
  const [serverSuggestion, setServerSuggestion] = useState<{ summary?: string; suggestions?: OutfitSuggestion[] } | null>(null);
  const [sizeAdvice, setSizeAdvice] = useState<any | null>(null);

  const localSuggestions = useMemo(() => getOutfitSuggestions(product), [product.id]);
  const related = useMemo(() => {
    const seen = new Set<string>();
    return products
      .filter((p) => p.id !== product.id && (p.subcategory === product.subcategory || p.category === product.category))
      .filter((p) => {
        const key = String(p.id || p.name);
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .slice(0, 8);
  }, [product.id, product.category, product.subcategory]);
  const suggestions = serverSuggestion?.suggestions?.length ? serverSuggestion.suggestions : localSuggestions;
  const galleryImages = useMemo(() => {
    const seen = new Set<string>();
    return [product.image, ...(((product as any).images || []) as string[])]
      .map((url) => String(url || '').trim())
      .filter((url) => {
        if (!url || seen.has(url)) return false;
        seen.add(url);
        return true;
      })
      .slice(0, 4);
  }, [product.id, product.image]);
  const [activeImageIndex, setActiveImageIndex] = useState(0);
  const activeImage = galleryImages[activeImageIndex] || product.image;
  const productSizes = Array.isArray((product as any).sizes) ? ((product as any).sizes as string[]) : [];
  const productColors = Array.isArray((product as any).colors) ? ((product as any).colors as string[]) : [];
  const productDimensions = String((product as any).dimensions || '');
  const productFit = String((product as any).fit || '');

  useEffect(() => {
    setActiveImageIndex(0);
  }, [product.id]);

  useEffect(() => {
    if (galleryImages.length <= 1) return;
    const timer = setInterval(() => {
      setActiveImageIndex((current) => (current + 1) % galleryImages.length);
    }, 3200);
    return () => clearInterval(timer);
  }, [galleryImages.length, product.id]);

  useEffect(() => {
    let mounted = true;
    setServerSuggestion(null);
    setAiLoading(true);
    api
      .getStyleSuggestions(product.id, user?.id || 'guest')
      .then((data) => {
        if (!mounted) return;
        if (data?.suggestions?.length || data?.summary) setServerSuggestion(data);
      })
      .catch(() => null)
      .finally(() => mounted && setAiLoading(false));
    api
      .getSizeAdvice(product.id, user?.id || 'guest')
      .then((data) => mounted && setSizeAdvice(data?.advice || null))
      .catch(() => mounted && setSizeAdvice(null));
    return () => {
      mounted = false;
    };
  }, [product.id, user?.id]);

  const startTryOn = (comboItems?: Product[], comboTitle?: string) => {
    const ids = comboItems?.length ? comboItems.map((item) => item.id).filter(Boolean).join(',') : product.id;
    router.push({
      pathname: '/try-on',
      params: { productId: product.id, comboIds: ids, comboTitle: comboTitle || '' },
    });
  };

  const buyNow = () => {
    if (addToCart(product)) {
      router.push('/cart');
    }
  };

  return (
    <View style={{ flex: 1, backgroundColor: theme.background }}>
      <Stack.Screen options={{ headerShown: false }} />
      <ScrollView contentContainerStyle={styles.content} showsVerticalScrollIndicator>
        <View style={styles.topBar}>
          <Pressable onPress={() => goBackOrReplace()} style={[styles.roundBtn, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
            <Feather name="arrow-left" size={21} color={theme.text} />
          </Pressable>
          <View style={{ flexDirection: 'row', gap: 10 }}>
            <Pressable onPress={() => toggleWishlist(product)} style={[styles.roundBtn, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
              <Feather name="heart" size={21} color={liked ? theme.primary : theme.text} />
            </Pressable>
            <Pressable onPress={() => router.push('/cart')} style={[styles.roundBtn, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
              <Feather name="shopping-bag" size={21} color={theme.text} />
            </Pressable>
          </View>
        </View>

        <View style={[styles.imageCard, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
          <SafeImage source={{ uri: activeImage }} style={styles.image} resizeMode="contain" />
          {(product.badge || hasDiscount) ? (
            <View style={[styles.badge, { backgroundColor: theme.primary }]}> 
              <Text style={[styles.badgeText, { color: theme.background }]}>{hasDiscount ? `GIẢM ${discountPercent}%` : product.badge}</Text>
            </View>
          ) : null}
        </View>

        <View style={[styles.thumbnailRow, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
          {galleryImages.map((url, index) => (
            <Pressable
              key={`${product.id}-gallery-${index}`}
              onPress={() => setActiveImageIndex(index)}
              style={[styles.thumbBtn, { borderColor: activeImageIndex === index ? theme.primary : theme.border, backgroundColor: theme.background }]}
            >
              <SafeImage source={{ uri: url }} style={styles.thumbImage} resizeMode="cover" />
            </Pressable>
          ))}
        </View>

        <View style={[styles.info, { backgroundColor: theme.card, borderColor: theme.border }, shadow(theme)]}>
          <Text style={[styles.category, { color: theme.primary, fontSize: scaleFont(theme, 11) }]}>{product.subcategory}</Text>
          <Text style={[styles.title, { color: theme.heading, fontFamily: fontFamily(theme), fontSize: scaleFont(theme, 30), lineHeight: scaleFont(theme, 35) }]}>{product.name}</Text>
          <View style={styles.priceLine}>
            <Text style={[styles.price, { color: theme.primary, fontSize: scaleFont(theme, 22) }]}>{formatCurrency(product.price)}</Text>
            {hasDiscount ? <Text style={[styles.oldPrice, { color: theme.muted }]}>{formatCurrency(originalPrice)}</Text> : null}
          </View>
          {sizeAdvice ? (
            <View style={[styles.sizeAdviceBox, { backgroundColor: theme.background, borderColor: theme.border }]}>
              <Feather name="user-check" size={18} color={theme.primary} />
              <Text style={[styles.sizeAdviceText, { color: theme.text }]}>
                Size gợi ý: <Text style={{ color: theme.primary, fontWeight: '900' }}>{sizeAdvice.recommendedSize}</Text>. {(sizeAdvice.notes || []).slice(0, 2).join(' ')}
              </Text>
            </View>
          ) : null}
          <Text style={[styles.desc, { color: theme.text, fontSize: scaleFont(theme, 15) }]}>{product.description}</Text>

          <View style={styles.specGrid}>
            {!!productSizes.length && (
              <View style={[styles.specBox, { backgroundColor: theme.background, borderColor: theme.border }]}>
                <Text style={[styles.specLabel, { color: theme.muted }]}>SIZE / KÍCH CỠ</Text>
                <Text style={[styles.specValue, { color: theme.heading }]}>{productSizes.join(' • ')}</Text>
              </View>
            )}
            {!!productColors.length && (
              <View style={[styles.specBox, { backgroundColor: theme.background, borderColor: theme.border }]}>
                <Text style={[styles.specLabel, { color: theme.muted }]}>MÀU SẮC</Text>
                <Text style={[styles.specValue, { color: theme.heading }]}>{productColors.join(' • ')}</Text>
              </View>
            )}
            {!!productDimensions && (
              <View style={[styles.specBox, { backgroundColor: theme.background, borderColor: theme.border }]}>
                <Text style={[styles.specLabel, { color: theme.muted }]}>KÍCH THƯỚC</Text>
                <Text style={[styles.specValue, { color: theme.heading }]}>{productDimensions}</Text>
              </View>
            )}
            {!!productFit && (
              <View style={[styles.specBox, { backgroundColor: theme.background, borderColor: theme.border }]}>
                <Text style={[styles.specLabel, { color: theme.muted }]}>FORM</Text>
                <Text style={[styles.specValue, { color: theme.heading }]}>{productFit}</Text>
              </View>
            )}
          </View>

          {!!product.visualTags?.length && (
            <View style={styles.tagWrap}>
              {product.visualTags.map((tag) => (
                <View key={tag} style={[styles.tag, { borderColor: theme.border, backgroundColor: theme.background }]}> 
                  <Text style={[styles.tagText, { color: theme.primary }]}>{tag}</Text>
                </View>
              ))}
            </View>
          )}

          <View style={[styles.storyBox, { backgroundColor: theme.background, borderColor: theme.border }]}> 
            <Feather name="star" size={18} color={theme.primary} />
            <Text style={[styles.story, { color: theme.text, fontSize: scaleFont(theme, 14) }]}>{product.story}</Text>
          </View>

          <View style={styles.actions}>
            <Pressable onPress={() => addToCart(product)} style={[styles.primaryBtn, { backgroundColor: theme.primary }]}> 
              <Feather name="shopping-bag" size={18} color={theme.background} />
              <Text style={[styles.primaryText, { color: theme.background }]}>Thêm vào giỏ</Text>
            </Pressable>
            <View style={{ flexDirection: 'row', gap: 10 }}>
              <Pressable onPress={() => startTryOn()} style={[styles.secondaryBtn, { borderColor: theme.primary, flex: 1 }]}> 
                <Feather name="camera" size={18} color={theme.primary} />
                <Text style={[styles.secondaryText, { color: theme.primary }]}>Thử đồ AI</Text>
              </Pressable>
              <Pressable onPress={buyNow} style={[styles.secondaryBtn, { borderColor: theme.primary, flex: 1 }]}> 
                <Feather name="credit-card" size={18} color={theme.primary} />
                <Text style={[styles.secondaryText, { color: theme.primary }]}>Mua ngay</Text>
              </Pressable>
            </View>
          </View>
        </View>

        <View style={[cardStyle(theme), styles.tryOnBox]}>
          <View style={{ flex: 1 }}>
            <Text style={[styles.category, { color: theme.primary, fontSize: scaleFont(theme, 10) }]}>THỬ ĐỒ AI</Text>
            <Text style={[styles.sectionTitle, { color: theme.heading, fontFamily: fontFamily(theme), fontSize: scaleFont(theme, 23) }]}>Kéo xuống thử ngay món này</Text>
            <Text style={[styles.aiIntro, { color: theme.muted, fontSize: scaleFont(theme, 13) }]}>Trang thử đồ sẽ chỉ lấy món người dùng đang xem làm món chính, bên dưới tự hiện các sản phẩm phối cùng để chọn thành combo.</Text>
          </View>
          <Pressable onPress={() => startTryOn()} style={[styles.tryOnBtn, { backgroundColor: theme.primary }]}> 
            <Feather name="camera" size={18} color={theme.background} />
            <Text style={[styles.tryOnBtnText, { color: theme.background }]}>Thử đồ</Text>
          </Pressable>
        </View>

        <View style={[cardStyle(theme), styles.aiBox]}>
          <View style={styles.sectionHeaderRow}>
            <View style={{ flex: 1 }}>
              <Text style={[styles.category, { color: theme.primary, fontSize: scaleFont(theme, 10) }]}>AI STYLIST</Text>
              <Text style={[styles.sectionTitle, { color: theme.heading, fontFamily: fontFamily(theme), fontSize: scaleFont(theme, 24) }]}>Gemini gợi ý set đi chung</Text>
            </View>
            {aiLoading ? <ActivityIndicator color={theme.primary} /> : <Feather name="zap" size={22} color={theme.primary} />}
          </View>
          <Text style={[styles.aiIntro, { color: theme.muted, fontSize: scaleFont(theme, 13) }]}>Gemini phân tích sản phẩm chính, màu sắc, form dáng và catalog để gợi ý áo/quần/phụ kiện/đạo cụ đi chung thành một bộ.</Text>
          {serverSuggestion?.summary ? <Text style={[styles.serverSummary, { color: theme.text, borderColor: theme.border, backgroundColor: theme.background }]}>{serverSuggestion.summary}</Text> : null}

          {suggestions.map((suggestion, idx) => (
            <View key={`suggestion-${String(suggestion.id || suggestion.title || 'item')}-${idx}`} style={[styles.suggestion, { borderColor: theme.border, backgroundColor: theme.background }]}> 
              <View style={styles.suggestionHeader}>
                <Text style={[styles.suggestionTitle, { color: theme.heading, fontFamily: fontFamily(theme) }]}>{suggestion.title}</Text>
                <View style={[styles.mood, { backgroundColor: theme.primary }]}> 
                  <Text style={[styles.moodText, { color: theme.background }]}>{suggestion.mood}</Text>
                </View>
              </View>
              <Text style={[styles.reason, { color: theme.text, fontSize: scaleFont(theme, 13) }]}>{suggestion.reason}</Text>
              <ScrollView horizontal showsHorizontalScrollIndicator contentContainerStyle={styles.outfitItems}>
                {suggestion.items.map((item: Product, itemIndex: number) => (
                  <Pressable key={`outfit-${String(suggestion.id || suggestion.title || 'set')}-${String(item.id || item.name)}-${itemIndex}`} onPress={() => router.push(`/product/${item.id}`)} style={[styles.outfitItem, { backgroundColor: theme.card, borderColor: theme.border }]}> 
                    <SafeImage source={{ uri: item.image }} style={styles.outfitImage} resizeMode="contain" />
                    <Text numberOfLines={2} style={[styles.outfitName, { color: theme.heading, fontFamily: fontFamily(theme) }]}>{item.name}</Text>
                    <Text style={[styles.outfitPrice, { color: theme.primary }]}>{formatCurrency(item.price)}</Text>
                  </Pressable>
                ))}
              </ScrollView>
              <View style={styles.setActions}>
                <Pressable onPress={() => startTryOn(suggestion.items, suggestion.title)} style={[styles.addSetBtn, { backgroundColor: theme.card, borderColor: theme.primary, borderWidth: 1, flex: 1 }]}> 
                  <Feather name="camera" size={16} color={theme.primary} />
                  <Text style={[styles.addSetText, { color: theme.primary }]}>Thử set này</Text>
                </Pressable>
                <Pressable onPress={() => suggestion.items.forEach((item: Product) => addToCart(item))} style={[styles.addSetBtn, { backgroundColor: theme.primary, flex: 1 }]}> 
                  <Feather name="plus-circle" size={16} color={theme.background} />
                  <Text style={[styles.addSetText, { color: theme.background }]}>Thêm cả set</Text>
                </Pressable>
              </View>
            </View>
          ))}
        </View>

        <Text style={[styles.sectionTitle, { color: theme.heading, fontFamily: fontFamily(theme), fontSize: scaleFont(theme, 23) }]}>Sản phẩm cùng nhóm</Text>
        <ScrollView horizontal showsHorizontalScrollIndicator contentContainerStyle={{ gap: 12 }}>
          {related.map((p, index) => <ProductCard key={`related-${String(p.id || p.name)}-${index}`} product={p} compact />)}
        </ScrollView>
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  content: { padding: 16, paddingTop: 52, paddingBottom: 140, gap: 16 },
  topBar: { flexDirection: 'row', justifyContent: 'space-between', marginTop: 6 },
  roundBtn: { width: 46, height: 46, borderRadius: 0, alignItems: 'center', justifyContent: 'center', borderWidth: 1 },
  imageCard: { borderWidth: 1, borderRadius: 0, height: 370, overflow: 'hidden', padding: 12, position: 'relative' },
  image: { width: '100%', height: '100%' },
  thumbnailRow: { borderWidth: 1, borderRadius: 0, padding: 10, flexDirection: 'row', gap: 10 },
  thumbBtn: { flex: 1, height: 76, borderWidth: 2, borderRadius: 0, padding: 3, overflow: 'hidden' },
  thumbImage: { width: '100%', height: '100%', borderRadius: 0 },
  badge: { position: 'absolute', left: 20, top: 20, borderRadius: 0, paddingHorizontal: 12, paddingVertical: 7 },
  badgeText: { fontSize: 11, fontWeight: '900' },
  info: { borderWidth: 1, borderRadius: 0, padding: 18, gap: 12 },
  category: { textTransform: 'uppercase', letterSpacing: 2, fontWeight: '900' },
  title: { fontWeight: '900' },
  priceLine: { flexDirection: 'row', alignItems: 'flex-end', gap: 10, flexWrap: 'wrap' },
  price: { fontWeight: '900' },
  oldPrice: { fontSize: 18, fontWeight: '800', textDecorationLine: 'line-through' },
  sizeAdviceBox: { borderWidth: 1, borderRadius: 0, padding: 12, flexDirection: 'row', gap: 9 },
  sizeAdviceText: { flex: 1, lineHeight: 20, fontWeight: '700' },
  desc: { lineHeight: 23 },
  specGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: 10 },
  specBox: { flexGrow: 1, flexBasis: 145, borderWidth: 1, borderRadius: 0, padding: 12, gap: 5 },
  specLabel: { fontSize: 10, fontWeight: '900', letterSpacing: 1 },
  specValue: { fontSize: 13, fontWeight: '900', lineHeight: 18 },
  tagWrap: { flexDirection: 'row', flexWrap: 'wrap', gap: 8 },
  tag: { borderWidth: 1, borderRadius: 0, paddingHorizontal: 10, paddingVertical: 6 },
  tagText: { fontSize: 11, fontWeight: '800' },
  storyBox: { borderWidth: 1, borderRadius: 0, padding: 14, flexDirection: 'row', gap: 10 },
  story: { flex: 1, lineHeight: 21 },
  actions: { gap: 10 },
  primaryBtn: { height: 54, borderRadius: 0, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8 },
  primaryText: { fontWeight: '900', letterSpacing: 1 },
  secondaryBtn: { height: 52, borderRadius: 0, borderWidth: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 7, paddingHorizontal: 8 },
  secondaryText: { fontWeight: '900', letterSpacing: 0.6, fontSize: 12 },
  sectionTitle: { fontWeight: '900' },
  tryOnBox: { padding: 16, gap: 12, flexDirection: 'row', alignItems: 'center' },
  tryOnBtn: { minHeight: 48, borderRadius: 0, paddingHorizontal: 16, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8 },
  tryOnBtnText: { fontWeight: '900', letterSpacing: 0.8 },
  aiBox: { padding: 16, gap: 12 },
  sectionHeaderRow: { flexDirection: 'row', alignItems: 'center', gap: 12 },
  aiIntro: { lineHeight: 20 },
  serverSummary: { borderWidth: 1, borderRadius: 0, padding: 12, lineHeight: 20 },
  suggestion: { borderWidth: 1, borderRadius: 0, padding: 13, gap: 10 },
  suggestionHeader: { flexDirection: 'row', alignItems: 'flex-start', justifyContent: 'space-between', gap: 10 },
  suggestionTitle: { flex: 1, fontSize: 18, fontWeight: '900', lineHeight: 23 },
  mood: { borderRadius: 0, paddingHorizontal: 10, paddingVertical: 5, maxWidth: 120 },
  moodText: { fontSize: 10, fontWeight: '900' },
  reason: { lineHeight: 20 },
  outfitItems: { gap: 10, paddingVertical: 4 },
  outfitItem: { width: 128, borderWidth: 1, borderRadius: 0, padding: 8, gap: 6 },
  outfitImage: { height: 90, width: '100%', borderRadius: 0},
  outfitName: { fontSize: 12, fontWeight: '900', lineHeight: 16 },
  outfitPrice: { fontSize: 11, fontWeight: '900' },
  setActions: { flexDirection: 'row', gap: 8 },
  addSetBtn: { height: 42, borderRadius: 0, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8 },
  addSetText: { fontWeight: '900', letterSpacing: 0.8, fontSize: 12 },
});
