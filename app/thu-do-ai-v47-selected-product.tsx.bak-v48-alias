import React, { useEffect, useMemo, useState } from 'react';
import { Alert, FlatList, Image, ScrollView, StyleSheet, Switch, Text, TextInput, TouchableOpacity, View } from 'react-native';
import * as ImagePicker from 'expo-image-picker';
import { useLocalSearchParams } from 'expo-router';
import { v47FirstImage, v47Get, v47Post, v47ProductId } from '../lib/japanoV47SelectedProductApi';

type Img = { uri: string; base64?: string };

function money(n: any) {
  return `${Number(n || 0).toLocaleString('vi-VN')}đ`;
}

async function pickPersonImage(setter: (v: Img) => void) {
  const r = await ImagePicker.launchImageLibraryAsync({
    mediaTypes: ['images'],
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

async function takePersonPhoto(setter: (v: Img) => void) {
  const perm = await ImagePicker.requestCameraPermissionsAsync();
  if (!perm.granted) {
    Alert.alert('Chưa có quyền camera', 'Hãy cấp quyền camera để chụp ảnh.');
    return;
  }
  const r = await ImagePicker.launchCameraAsync({
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

function productText(p: any) {
  return `${p?.name || ''} ${p?.category || ''} ${p?.subcategory || ''} ${p?.description || ''} ${(p?.visualTags || []).join(' ')}`.toLowerCase();
}

function isAccessory(p: any) {
  const t = productText(p);
  return [
    'accessory','accessories','phụ kiện','phu kien',
    'dây chuyền','day chuyen','necklace',
    'đồng hồ','dong ho','watch',
    'túi','tui','bag','tote',
    'kính','kinh','glasses','sunglasses',
    'nón','non','hat',
    'vòng','vong','bracelet',
    'dù','du','umbrella',
    'khăn','khan','scarf','headscarf',
    'bông tai','bong tai','earrings',
    'thắt lưng','that lung','belt',
    'kẹp tóc','kep toc','hairclip'
  ].some((x) => t.includes(x));
}

function ProductCard({ p, selected, onPress }: any) {
  const img = v47FirstImage(p);
  return (
    <TouchableOpacity onPress={() => onPress(p)} style={[s.productCard, selected && s.productSelected]}>
      <Image source={{ uri: img || 'https://placehold.co/500x700/fdf2f8/be185d?text=JAPANO' }} style={s.productImg} />
      <Text numberOfLines={2} style={s.productName}>{p?.name || 'Phụ kiện shop'}</Text>
      <Text style={s.price}>{money(p?.price)}</Text>
      <Text numberOfLines={1} style={s.small}>{p?.subcategory || p?.category || 'shop'}</Text>
    </TouchableOpacity>
  );
}

export default function ThuDoAiV47SelectedProductScreen() {
  const params = useLocalSearchParams?.() || {};
  const paramProductId = String(params.productId || params.id || params._id || '');
  const paramProductJson = String(params.product || '');

  const [person, setPerson] = useState<Img | null>(null);
  const [mainProduct, setMainProduct] = useState<any | null>(null);
  const [allProducts, setAllProducts] = useState<any[]>([]);
  const [accessoryProducts, setAccessoryProducts] = useState<any[]>([]);
  const [accessoryCandidates, setAccessoryCandidates] = useState<any[]>([]);
  const [recommendedMode, setRecommendedMode] = useState(false);
  const [query, setQuery] = useState('');
  const [sizeInfo, setSizeInfo] = useState('');
  const [adultConfirmed, setAdultConfirmed] = useState(false);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState('Hãy chọn/chụp ảnh người dùng. Sản phẩm chính được lấy từ món đồ bạn đã bấm ở shop.');
  const [tips, setTips] = useState<any>(null);
  const [resultImg, setResultImg] = useState('');

  async function loadProductsAndSelected() {
    try {
      setLoading(true);
      let selectedFromParam: any = null;

      if (paramProductJson) {
        try { selectedFromParam = JSON.parse(decodeURIComponent(paramProductJson)); } catch {}
      }

      const data = await v47Get('/api/v47/shop/products');
      const items = data.items || [];
      setAllProducts(items);
      const accessories = items.filter(isAccessory);
      setAccessoryCandidates(accessories);

      if (selectedFromParam) {
        setMainProduct(selectedFromParam);
      } else if (paramProductId) {
        const found = items.find((p) => v47ProductId(p) === paramProductId);
        setMainProduct(found || null);
      } else if (!mainProduct) {
        const firstGarment = items.find((p) => !isAccessory(p));
        setMainProduct(firstGarment || null);
      }

      setMessage('Đã tải sản phẩm shop. Ảnh đồ chính là ảnh đầu tiên của sản phẩm được chọn.');
    } catch (e: any) {
      Alert.alert('Không tải được sản phẩm shop', e.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { loadProductsAndSelected(); }, []);

  const shownAccessories = useMemo(() => {
    const q = query.trim().toLowerCase();
    return accessoryCandidates.filter((p) => !q || productText(p).includes(q));
  }, [accessoryCandidates, query]);

  function toggleAccessory(p: any) {
    const id = v47ProductId(p);
    setAccessoryProducts((old) => {
      if (old.some((x) => v47ProductId(x) === id)) return old.filter((x) => v47ProductId(x) !== id);
      return [...old, p].slice(0, 5);
    });
  }

  async function suggestAccessories() {
    if (!person?.base64) {
      Alert.alert('Cần ảnh người dùng', 'Hãy chọn/chụp ảnh người dùng trước, rồi mới bấm gợi ý.');
      return;
    }
    if (!mainProduct) {
      Alert.alert('Chưa có sản phẩm chính', 'Hãy bấm thử đồ từ một sản phẩm trong shop.');
      return;
    }

    try {
      setLoading(true);
      setRecommendedMode(true);
      const data = await v47Post('/api/v47/shop/recommend-accessories', {
        personImageBase64: person.base64,
        mainProductId: v47ProductId(mainProduct),
        sizeInfo,
        adultConfirmed,
      });

      const items = data.items || [];
      setAccessoryCandidates(items.length ? items : accessoryCandidates);
      setAccessoryProducts((data.autoSelected || []).slice(0, 3));
      setTips(data.tips || null);
      setMessage('Đã gợi ý phụ kiện từ shop theo ảnh người dùng và món đồ chính.');
    } catch (e: any) {
      Alert.alert('Gợi ý lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  async function runTryOn() {
    if (!person?.base64) {
      Alert.alert('Thiếu ảnh người', 'Hãy chọn/chụp ảnh người dùng trước.');
      return;
    }
    if (!mainProduct) {
      Alert.alert('Thiếu sản phẩm chính', 'Hãy quay lại trang sản phẩm và bấm thử đồ trên món muốn thử.');
      return;
    }

    try {
      setLoading(true);
      setResultImg('');
      const data = await v47Post('/api/v47/mobile/tryon-selected-product', {
        personImageBase64: person.base64,
        mainProductId: v47ProductId(mainProduct),
        accessoryProductIds: accessoryProducts.map(v47ProductId),
        sizeInfo,
        adultConfirmed,
        consistencyPolicy: 'first-image-anchor',
      });

      const final = data?.finalImageBase64
        ? (String(data.finalImageBase64).startsWith('data:') ? data.finalImageBase64 : `data:image/png;base64,${data.finalImageBase64}`)
        : '';

      setResultImg(final);
      setTips(data?.tips || data?.styleSuggest || null);
      setMessage(data?.message || 'Đã tạo thử đồ bằng sản phẩm shop.');
      if (!final) Alert.alert('Chưa có ảnh kết quả', data?.message || 'AI Gateway chưa trả ảnh.');
    } catch (e: any) {
      Alert.alert('Thử đồ lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  const mainImg = v47FirstImage(mainProduct);

  return (
    <ScrollView contentContainerStyle={s.container}>
      <Text style={s.title}>Thử đồ AI Shop V47</Text>
      <Text style={s.sub}>
        Ảnh đồ chính lấy từ sản phẩm bạn bấm trong shop. Phụ kiện lấy từ sản phẩm phụ kiện của shop, có ảnh và giá để chọn.
      </Text>

      <View style={s.card}>
        <Text style={s.section}>Sản phẩm đang thử</Text>
        {mainProduct ? (
          <View style={s.selectedProduct}>
            <Image source={{ uri: mainImg || 'https://placehold.co/600x800/fdf2f8/be185d?text=JAPANO' }} style={s.selectedImg} />
            <View style={{ flex: 1 }}>
              <Text style={s.selectedName}>{mainProduct.name}</Text>
              <Text style={s.price}>{money(mainProduct.price)}</Text>
              <Text style={s.note}>Dùng ảnh đầu tiên của sản phẩm làm ảnh đồ mẫu.</Text>
            </View>
          </View>
        ) : (
          <Text style={s.warn}>Chưa nhận được sản phẩm. Hãy quay lại trang sản phẩm và bấm “Thử đồ”.</Text>
        )}
      </View>

      <View style={s.card}>
        <Text style={s.section}>1. Ảnh người dùng</Text>
        <View style={s.rowButtons}>
          <TouchableOpacity style={s.btnSec} onPress={() => pickPersonImage(setPerson)}>
            <Text style={s.btnSecText}>Chọn ảnh người</Text>
          </TouchableOpacity>
          <TouchableOpacity style={s.btnSec} onPress={() => takePersonPhoto(setPerson)}>
            <Text style={s.btnSecText}>Chụp ảnh</Text>
          </TouchableOpacity>
        </View>
        {person?.uri ? <Image source={{ uri: person.uri }} style={s.personPreview} /> : null}
      </View>

      {person?.uri ? (
        <View style={s.card}>
          <Text style={s.section}>2. Thông tin gợi ý</Text>
          <TextInput
            style={[s.input, { minHeight: 72 }]}
            multiline
            value={sizeInfo}
            onChangeText={setSizeInfo}
            placeholder="Nhập chiều cao, cân nặng, eo, hông, cổ tay nếu muốn gợi ý size/phụ kiện sát hơn..."
          />
          <View style={s.row}>
            <Text style={{ flex: 1, color: '#9d174d', fontWeight: '800' }}>
              Xác nhận adult fashion nếu sản phẩm là bikini / đồ bơi / crop-top
            </Text>
            <Switch value={adultConfirmed} onValueChange={setAdultConfirmed} />
          </View>
          <TouchableOpacity style={s.btn} onPress={suggestAccessories} disabled={loading}>
            <Text style={s.btnText}>{loading ? 'Đang gợi ý...' : 'Gợi ý phụ kiện từ shop'}</Text>
          </TouchableOpacity>
        </View>
      ) : null}

      <View style={s.card}>
        <Text style={s.section}>{recommendedMode ? '3. Phụ kiện AI gợi ý từ shop' : '3. Phụ kiện trong shop'}</Text>
        <Text style={s.note}>
          Chọn phụ kiện shop để gắn lên ảnh người: dù, dây chuyền, khăn trùm đầu, đồng hồ, túi, kính, nón...
        </Text>
        <TextInput style={s.input} placeholder="Tìm phụ kiện trong shop..." value={query} onChangeText={setQuery} />
        <FlatList
          horizontal
          data={shownAccessories}
          keyExtractor={(p, i) => `${v47ProductId(p)}-${i}`}
          renderItem={({ item }) => (
            <ProductCard
              p={item}
              selected={accessoryProducts.some((x) => v47ProductId(x) === v47ProductId(item))}
              onPress={toggleAccessory}
            />
          )}
          showsHorizontalScrollIndicator={false}
        />
        <Text style={s.note}>Đã chọn: {accessoryProducts.map((x) => x.name).join(', ') || 'chưa chọn phụ kiện'}</Text>
      </View>

      {tips ? (
        <View style={s.card}>
          <Text style={s.section}>Kết quả gợi ý</Text>
          <Text style={s.note}>Tóm tắt: {tips.summary || '—'}</Text>
          <Text style={s.note}>Size: {(tips.sizeAdvice || []).join(' | ') || '—'}</Text>
          <Text style={s.note}>Phụ kiện: {(tips.accessoryAdvice || []).join(' | ') || '—'}</Text>
        </View>
      ) : null}

      <TouchableOpacity style={[s.btn, { backgroundColor: '#111827' }]} onPress={runTryOn} disabled={loading}>
        <Text style={s.btnText}>{loading ? 'Đang tạo...' : 'Tạo thử đồ với sản phẩm này'}</Text>
      </TouchableOpacity>

      <View style={s.card}>
        <Text style={s.section}>Trạng thái</Text>
        <Text style={s.note}>{message}</Text>
      </View>

      {resultImg ? (
        <View style={s.card}>
          <Text style={s.section}>Kết quả cuối</Text>
          <Image source={{ uri: resultImg }} style={s.result} />
          <Text style={s.note}>Nếu AI trả nhiều ảnh không giống nhau, app lấy ảnh đầu tiên làm final.</Text>
        </View>
      ) : null}
    </ScrollView>
  );
}

const s = StyleSheet.create({
  container: { padding: 16, gap: 14, backgroundColor: '#fff8fb' },
  title: { fontSize: 30, fontWeight: '900', color: '#831843', marginTop: 12 },
  sub: { color: '#6b7280', lineHeight: 20 },
  card: { backgroundColor: 'white', borderRadius: 18, padding: 14, borderWidth: 1, borderColor: '#fbcfe8', gap: 10 },
  section: { fontSize: 20, fontWeight: '900', color: '#9d174d' },
  selectedProduct: { flexDirection: 'row', gap: 12, alignItems: 'center' },
  selectedImg: { width: 96, height: 126, borderRadius: 14, backgroundColor: '#f3f4f6' },
  selectedName: { fontWeight: '900', fontSize: 17, color: '#111827' },
  input: { borderWidth: 1, borderColor: '#f9a8d4', borderRadius: 12, padding: 12, backgroundColor: '#fff' },
  row: { flexDirection: 'row', alignItems: 'center', gap: 10 },
  rowButtons: { flexDirection: 'row', gap: 10 },
  btn: { backgroundColor: '#ec4899', borderRadius: 14, padding: 14, alignItems: 'center' },
  btnText: { color: 'white', fontWeight: '900' },
  btnSec: { flex: 1, backgroundColor: '#fdf2f8', borderRadius: 12, padding: 12, alignItems: 'center', borderWidth: 1, borderColor: '#f9a8d4' },
  btnSecText: { color: '#be185d', fontWeight: '900' },
  personPreview: { width: '100%', height: 300, borderRadius: 16, backgroundColor: '#f3f4f6' },
  productCard: { width: 150, marginRight: 10, padding: 8, borderRadius: 16, backgroundColor: '#fff', borderWidth: 1, borderColor: '#fce7f3' },
  productSelected: { borderColor: '#ec4899', borderWidth: 3, backgroundColor: '#fdf2f8' },
  productImg: { width: '100%', height: 150, borderRadius: 12, backgroundColor: '#f3f4f6' },
  productName: { fontWeight: '800', color: '#111827', marginTop: 6, minHeight: 38 },
  price: { color: '#be185d', fontWeight: '900' },
  small: { color: '#6b7280', fontSize: 12 },
