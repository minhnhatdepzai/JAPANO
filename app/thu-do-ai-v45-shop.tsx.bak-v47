// @ts-nocheck
import React, { useEffect, useMemo, useState } from 'react';
import { Alert, FlatList, Image, ScrollView, StyleSheet, Switch, Text, TextInput, TouchableOpacity, View } from 'react-native';
import * as ImagePicker from 'expo-image-picker';
import { v45FirstImage, v45Get, v45Post, v45ProductId } from '../lib/japanoV45ShopTryonApi';

type Img = { uri: string; base64?: string };

async function pickPersonImage(setter: (v: Img) => void) {
  const r = await ImagePicker.launchImageLibraryAsync({
    mediaTypes: ['images'],
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

async function takePersonPhoto(setter: (v: Img) => void) {
  const perm = await ImagePicker.requestCameraPermissionsAsync();
  if (!perm.granted) {
    Alert.alert('Chưa có quyền camera', 'Hãy cấp quyền camera để chụp ảnh người dùng.');
    return;
  }
  const r = await ImagePicker.launchCameraAsync({
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

function money(n: any) {
  return `${Number(n || 0).toLocaleString('vi-VN')}đ`;
}

function productText(p: any) {
  return `${p?.name || ''} ${p?.category || ''} ${p?.subcategory || ''} ${p?.description || ''} ${(p?.visualTags || []).join(' ')}`.toLowerCase();
}

function isAccessory(p: any) {
  const t = productText(p);
  return [
    'accessory', 'accessories', 'phụ kiện', 'phu kien',
    'dây chuyền', 'day chuyen', 'necklace',
    'đồng hồ', 'dong ho', 'watch',
    'túi', 'tui', 'bag',
    'kính', 'kinh', 'glasses', 'sunglasses',
    'nón', 'non', 'hat',
    'vòng', 'vong', 'bracelet',
  ].some((x) => t.includes(x));
}

function isGarment(p: any) {
  return !isAccessory(p);
}

function ProductCard({ p, selected, onPress, accessory = false }: any) {
  const img = v45FirstImage(p);
  return (
    <TouchableOpacity onPress={() => onPress(p)} style={[s.productCard, selected && s.productSelected]}>
      <Image source={{ uri: img || 'https://placehold.co/500x700/fdf2f8/be185d?text=JAPANO' }} style={s.productImg} />
      <Text numberOfLines={2} style={s.productName}>{p?.name || 'Sản phẩm shop'}</Text>
      <Text style={s.price}>{money(p?.price)}</Text>
      <Text numberOfLines={1} style={s.small}>{accessory ? 'Phụ kiện shop' : (p?.subcategory || p?.category || 'Đồ shop')}</Text>
    </TouchableOpacity>
  );
}

export default function ThuDoAiV45ShopScreen() {
  const [products, setProducts] = useState<any[]>([]);
  const [recommended, setRecommended] = useState<any[]>([]);
  const [query, setQuery] = useState('');
  const [person, setPerson] = useState<Img | null>(null);
  const [mainProduct, setMainProduct] = useState<any | null>(null);
  const [accessoryProducts, setAccessoryProducts] = useState<any[]>([]);
  const [sizeInfo, setSizeInfo] = useState('Chiều cao 165, cân nặng 50, eo 66, hông 88, cổ tay nhỏ');
  const [adultConfirmed, setAdultConfirmed] = useState(false);
  const [loading, setLoading] = useState(false);
  const [resultImg, setResultImg] = useState('');
  const [message, setMessage] = useState('Chọn ảnh người. Đồ và phụ kiện sẽ lấy từ sản phẩm shop của bạn.');
  const [tips, setTips] = useState<any>(null);

  async function loadShopProducts() {
    try {
      setLoading(true);
      const data = await v45Get('/api/v45/shop/products');
      const items = data.items || [];
      setProducts(items);
      setRecommended(data.recommended || items.slice(0, 12));
      if (!mainProduct) {
        const firstGarment = items.find(isGarment) || items[0];
        if (firstGarment) setMainProduct(firstGarment);
      }
      setMessage(`Đã tải ${items.length} sản phẩm từ shop/database.`);
    } catch (e: any) {
      Alert.alert('Không tải được sản phẩm shop', e.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { loadShopProducts(); }, []);

  const garments = useMemo(() => {
    const q = query.trim().toLowerCase();
    return products.filter((p) => isGarment(p) && (!q || productText(p).includes(q)));
  }, [products, query]);

  const accessories = useMemo(() => {
    const q = query.trim().toLowerCase();
    return products.filter((p) => isAccessory(p) && (!q || productText(p).includes(q)));
  }, [products, query]);

  function toggleAccessory(p: any) {
    const id = v45ProductId(p);
    setAccessoryProducts((old) => {
      if (old.some((x) => v45ProductId(x) === id)) {
        return old.filter((x) => v45ProductId(x) !== id);
      }
      return [...old, p].slice(0, 5);
    });
  }

  async function askRecommend() {
    try {
      setLoading(true);
      const data = await v45Post('/api/v45/shop/recommend', {
        selectedProductId: mainProduct ? v45ProductId(mainProduct) : '',
        sizeInfo,
        hasPersonImage: Boolean(person?.base64),
      });
      setRecommended(data.items || []);
      setTips(data.tips || null);
      setMessage('AI đã gợi ý sản phẩm từ shop của bạn.');
    } catch (e: any) {
      Alert.alert('Gợi ý lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  async function runShopTryOn() {
    if (!person?.base64) {
      Alert.alert('Thiếu ảnh người', 'Hãy chọn hoặc chụp ảnh người dùng trước.');
      return;
    }
    if (!mainProduct) {
      Alert.alert('Thiếu sản phẩm shop', 'Hãy chọn một sản phẩm chính từ shop.');
      return;
    }
    try {
      setLoading(true);
      setResultImg('');
      const data = await v45Post('/api/v45/mobile/tryon-shop', {
        personImageBase64: person.base64,
        mainProductId: v45ProductId(mainProduct),
        accessoryProductIds: accessoryProducts.map(v45ProductId),
        sizeInfo,
        adultConfirmed,
        consistencyPolicy: 'first-image-anchor',
      });

      const final = data?.finalImageBase64
        ? (String(data.finalImageBase64).startsWith('data:')
          ? data.finalImageBase64
          : `data:image/png;base64,${data.finalImageBase64}`)
        : '';

      setResultImg(final);
      setTips(data?.tips || data?.styleSuggest || null);
      setMessage(data?.message || 'Đã tạo thử đồ từ sản phẩm shop.');
      if (!final) {
        Alert.alert('Chưa có ảnh kết quả', data?.message || 'AI Gateway chưa trả ảnh. Nhưng route shop đã chạy đúng.');
      }
    } catch (e: any) {
      Alert.alert('Thử đồ shop lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  return (
    <ScrollView contentContainerStyle={s.container}>
      <Text style={s.title}>Thử đồ AI Shop V45</Text>
      <Text style={s.sub}>
        Đồ mẫu và phụ kiện lấy từ sản phẩm đang bán trong shop/database. App dùng ảnh đầu tiên của sản phẩm để thử đồ.
      </Text>

      <View style={s.card}>
        <Text style={s.section}>1. Ảnh người dùng</Text>
        <View style={s.rowButtons}>
          <TouchableOpacity style={s.btnSec} onPress={() => pickPersonImage(setPerson)}>
            <Text style={s.btnSecText}>Chọn ảnh người</Text>
          </TouchableOpacity>
          <TouchableOpacity style={s.btnSec} onPress={() => takePersonPhoto(setPerson)}>
            <Text style={s.btnSecText}>Chụp ảnh</Text>
          </TouchableOpacity>
        </View>
        {person?.uri ? <Image source={{ uri: person.uri }} style={s.personPreview} /> : null}
      </View>

      <View style={s.card}>
        <Text style={s.section}>2. Sản phẩm chính từ shop</Text>
        <TextInput style={s.input} placeholder="Tìm áo, quần, váy, bikini, giày..." value={query} onChangeText={setQuery} />
        <TouchableOpacity style={s.btnSec} onPress={loadShopProducts}>
          <Text style={s.btnSecText}>Tải lại sản phẩm từ database</Text>
        </TouchableOpacity>
        <FlatList
          horizontal
          data={garments}
          keyExtractor={(p, i) => `${v45ProductId(p)}-${i}`}
          renderItem={({ item }) => (
            <ProductCard
              p={item}
              selected={v45ProductId(mainProduct) === v45ProductId(item)}
              onPress={setMainProduct}
            />
          )}
          showsHorizontalScrollIndicator={false}
        />
        {mainProduct ? (
          <Text style={s.note}>Đang chọn: {mainProduct.name} — ảnh dùng thử đồ là ảnh đầu tiên của sản phẩm.</Text>
        ) : null}
      </View>

      <View style={s.card}>
        <Text style={s.section}>3. Phụ kiện từ shop</Text>
        <Text style={s.note}>Chọn tối đa 5 món: dây chuyền, đồng hồ, túi, kính, nón, giày...</Text>
        <FlatList
          horizontal
          data={accessories}
          keyExtractor={(p, i) => `${v45ProductId(p)}-${i}`}
          renderItem={({ item }) => (
            <ProductCard
              p={item}
              accessory
              selected={accessoryProducts.some((x) => v45ProductId(x) === v45ProductId(item))}
              onPress={toggleAccessory}
            />
          )}
          showsHorizontalScrollIndicator={false}
        />
        <Text style={s.note}>Đã chọn: {accessoryProducts.map((x) => x.name).join(', ') || 'chưa chọn phụ kiện'}</Text>
      </View>

      <View style={s.card}>
        <Text style={s.section}>4. Size / policy</Text>
        <TextInput
          style={[s.input, { minHeight: 86 }]}
          multiline
          value={sizeInfo}
          onChangeText={setSizeInfo}
          placeholder="Nhập chiều cao, cân nặng, eo, hông, cổ tay..."
        />
        <View style={s.row}>
          <Text style={{ flex: 1, color: '#9d174d', fontWeight: '800' }}>
            Xác nhận adult fashion nếu sản phẩm shop là bikini / đồ bơi / crop-top
          </Text>
          <Switch value={adultConfirmed} onValueChange={setAdultConfirmed} />
        </View>
      </View>

      <View style={s.rowButtons}>
        <TouchableOpacity style={s.btn} onPress={askRecommend} disabled={loading}>
          <Text style={s.btnText}>{loading ? 'Đang chạy...' : 'Gợi ý từ shop'}</Text>
        </TouchableOpacity>
        <TouchableOpacity style={[s.btn, { backgroundColor: '#111827' }]} onPress={runShopTryOn} disabled={loading}>
          <Text style={s.btnText}>{loading ? 'Đang tạo...' : 'Tạo thử đồ shop'}</Text>
        </TouchableOpacity>
      </View>

      <View style={s.card}>
        <Text style={s.section}>Trạng thái</Text>
        <Text style={s.note}>{message}</Text>
      </View>

      {tips ? (
        <View style={s.card}>
          <Text style={s.section}>Gợi ý phối đồ từ shop</Text>
          <Text style={s.note}>Tóm tắt: {tips.summary || '—'}</Text>
          <Text style={s.note}>Size: {(tips.sizeAdvice || []).join(' | ') || '—'}</Text>
          <Text style={s.note}>Phụ kiện: {(tips.accessoryAdvice || []).join(' | ') || '—'}</Text>
        </View>
      ) : null}

      {recommended?.length ? (
        <View style={s.card}>
          <Text style={s.section}>Sản phẩm shop được gợi ý</Text>
          <FlatList
            horizontal
            data={recommended}
            keyExtractor={(p, i) => `rec-${v45ProductId(p)}-${i}`}
            renderItem={({ item }) => (
              <ProductCard
                p={item}
                selected={v45ProductId(mainProduct) === v45ProductId(item)}
                onPress={(p) => isAccessory(p) ? toggleAccessory(p) : setMainProduct(p)}
                accessory={isAccessory(item)}
              />
            )}
            showsHorizontalScrollIndicator={false}
          />
        </View>
      ) : null}

      {resultImg ? (
        <View style={s.card}>
          <Text style={s.section}>Kết quả cuối</Text>
          <Image source={{ uri: resultImg }} style={s.result} />
          <Text style={s.note}>Policy: lấy ảnh đầu tiên làm final nếu nhiều output không giống nhau.</Text>
        </View>
      ) : null}
    </ScrollView>
  );
}

const s = StyleSheet.create({
  container: { padding: 16, gap: 14, backgroundColor: '#fff8fb' },
  title: { fontSize: 30, fontWeight: '900', color: '#831843', marginTop: 12 },
  sub: { color: '#6b7280', lineHeight: 20 },
  card: { backgroundColor: 'white', borderRadius: 18, padding: 14, borderWidth: 1, borderColor: '#fbcfe8', gap: 10 },
  section: { fontSize: 20, fontWeight: '900', color: '#9d174d' },
  input: { borderWidth: 1, borderColor: '#f9a8d4', borderRadius: 12, padding: 12, backgroundColor: '#fff' },
  row: { flexDirection: 'row', alignItems: 'center', gap: 10 },
  rowButtons: { flexDirection: 'row', gap: 10 },
  btn: { flex: 1, backgroundColor: '#ec4899', borderRadius: 14, padding: 14, alignItems: 'center' },
  btnText: { color: 'white', fontWeight: '900' },
  btnSec: { flex: 1, backgroundColor: '#fdf2f8', borderRadius: 12, padding: 12, alignItems: 'center', borderWidth: 1, borderColor: '#f9a8d4' },
  btnSecText: { color: '#be185d', fontWeight: '900' },
  personPreview: { width: '100%', height: 300, borderRadius: 16, backgroundColor: '#f3f4f6' },
  productCard: { width: 142, marginRight: 10, padding: 8, borderRadius: 16, backgroundColor: '#fff', borderWidth: 1, borderColor: '#fce7f3' },
  productSelected: { borderColor: '#ec4899', borderWidth: 3, backgroundColor: '#fdf2f8' },
  productImg: { width: '100%', height: 150, borderRadius: 12, backgroundColor: '#f3f4f6' },
  productName: { fontWeight: '800', color: '#111827', marginTop: 6, minHeight: 38 },
  price: { color: '#be185d', fontWeight: '900' },
  small: { color: '#6b7280', fontSize: 12 },
  note: { color: '#374151', lineHeight: 20 },
  result: { width: '100%', height: 520, borderRadius: 16, backgroundColor: '#f3f4f6' },
});
