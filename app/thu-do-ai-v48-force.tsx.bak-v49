// @ts-nocheck
import React, { useEffect, useMemo, useState } from 'react';
import { Alert, FlatList, Image, ScrollView, StyleSheet, Switch, Text, TextInput, TouchableOpacity, View } from 'react-native';
import * as ImagePicker from 'expo-image-picker';
import { useLocalSearchParams, useRouter } from 'expo-router';
import { v48FirstImage, v48Get, v48Post, v48ProductId } from '../lib/japanoV48TryonFrontendApi';

type Img = { uri: string; base64?: string };

function money(n: any) {
  return `${Number(n || 0).toLocaleString('vi-VN')}đ`;
}

async function pickImage(setter: (v: Img) => void) {
  const r = await ImagePicker.launchImageLibraryAsync({
    mediaTypes: ['images'],
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

async function takePhoto(setter: (v: Img) => void) {
  const perm = await ImagePicker.requestCameraPermissionsAsync();
  if (!perm.granted) {
    Alert.alert('Chưa có quyền camera', 'Hãy cấp quyền camera để chụp ảnh.');
    return;
  }
  const r = await ImagePicker.launchCameraAsync({
    quality: 0.9,
    base64: true,
    allowsEditing: false,
  });
  if (r.canceled || !r.assets?.[0]) return;
  const a = r.assets[0];
  const mime = a.mimeType || 'image/jpeg';
  setter({ uri: a.uri, base64: `data:${mime};base64,${a.base64 || ''}` });
}

function textOf(p: any) {
  return `${p?.name || ''} ${p?.category || ''} ${p?.subcategory || ''} ${p?.description || ''} ${(p?.visualTags || []).join(' ')}`.toLowerCase();
}

function isAccessory(p: any) {
  const t = textOf(p);
  return [
    'accessory','accessories','phụ kiện','phu kien',
    'dây chuyền','day chuyen','necklace',
    'đồng hồ','dong ho','watch',
    'túi','tui','bag','tote',
    'kính','kinh','glasses','sunglasses',
    'nón','non','hat',
    'vòng','vong','bracelet',
    'dù','du','umbrella',
    'khăn','khan','scarf','headscarf',
    'bông tai','bong tai','earrings',
    'thắt lưng','that lung','belt',
    'kẹp tóc','kep toc','hairclip'
  ].some((x) => t.includes(x));
}

function AccessoryCard({ item, selected, onPress }: any) {
  const img = v48FirstImage(item);
  return (
    <TouchableOpacity onPress={() => onPress(item)} style={[s.accCard, selected && s.accSelected]}>
      <Image source={{ uri: img || 'https://placehold.co/500x700/fdf2f8/be185d?text=JAPANO' }} style={s.accImg} />
      <View style={s.accBody}>
        <Text numberOfLines={2} style={s.accName}>{item?.name || 'Phụ kiện shop'}</Text>
        <Text style={s.price}>{money(item?.price)}</Text>
        <Text numberOfLines={1} style={s.small}>{item?.subcategory || item?.category || 'phụ kiện'}</Text>
      </View>
      {selected ? <View style={s.check}><Text style={s.checkText}>✓</Text></View> : null}
    </TouchableOpacity>
  );
}

export default function ThuDoAiV48ForceScreen() {
  const router = useRouter?.();
  const params = useLocalSearchParams?.() || {};

  const paramProductId = String(params.productId || params.id || params._id || params.sku || '');
  const paramProductJson = String(params.product || '');

  const [person, setPerson] = useState<Img | null>(null);
  const [mainProduct, setMainProduct] = useState<any | null>(null);
  const [allProducts, setAllProducts] = useState<any[]>([]);
  const [accessories, setAccessories] = useState<any[]>([]);
  const [selectedAccessories, setSelectedAccessories] = useState<any[]>([]);
  const [query, setQuery] = useState('');
  const [suggested, setSuggested] = useState(false);
  const [sizeInfo, setSizeInfo] = useState('');
  const [adultConfirmed, setAdultConfirmed] = useState(false);
  const [tips, setTips] = useState<any>(null);
  const [resultImg, setResultImg] = useState('');
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState('Chọn/chụp ảnh của bạn. Đồ chính sẽ lấy từ sản phẩm bạn bấm trong shop.');

  async function loadData() {
    try {
      setLoading(true);

      let selectedFromParam = null;
      if (paramProductJson) {
        try { selectedFromParam = JSON.parse(decodeURIComponent(paramProductJson)); } catch {}
      }

      const data = await v48Get('/api/v48/shop/products');
      const items = data.items || [];
      setAllProducts(items);

      const acc = items.filter(isAccessory);
      setAccessories(acc);

      if (selectedFromParam) {
        setMainProduct(selectedFromParam);
      } else if (paramProductId) {
        const found = items.find((p) => v48ProductId(p) === paramProductId);
        setMainProduct(found || null);
      } else {
        const firstGarment = items.find((p) => !isAccessory(p));
        setMainProduct(firstGarment || null);
      }

      setMessage('Đã tải sản phẩm shop. Màn hình này KHÔNG còn chọn ảnh sản phẩm ngoài.');
    } catch (e: any) {
      Alert.alert('Lỗi tải dữ liệu shop', e.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { loadData(); }, []);

  const visibleAccessories = useMemo(() => {
    const q = query.trim().toLowerCase();
    return accessories.filter((p) => !q || textOf(p).includes(q));
  }, [accessories, query]);

  function toggleAccessory(p: any) {
    const id = v48ProductId(p);
    setSelectedAccessories((old) => {
      if (old.some((x) => v48ProductId(x) === id)) {
        return old.filter((x) => v48ProductId(x) !== id);
      }
      return [...old, p].slice(0, 5);
    });
  }

  async function suggestAccessories() {
    if (!person?.base64) {
      Alert.alert('Cần ảnh người dùng', 'Bạn cần thêm ảnh của bạn trước, rồi mới bấm gợi ý.');
      return;
    }
    if (!mainProduct) {
      Alert.alert('Chưa có sản phẩm chính', 'Hãy bấm thử đồ từ một sản phẩm trong shop.');
      return;
    }

    try {
      setLoading(true);
      const data = await v48Post('/api/v48/shop/recommend-accessories', {
        personImageBase64: person.base64,
        mainProductId: v48ProductId(mainProduct),
        sizeInfo,
        adultConfirmed,
      });

      const newAccessories = data.items || [];
      const autoSelected = data.autoSelected || [];
      setAccessories(newAccessories.length ? newAccessories : accessories);
      setSelectedAccessories(autoSelected.slice(0, 3));
      setTips(data.tips || null);
      setSuggested(true);
      setMessage('Đã gợi ý phụ kiện phù hợp hơn theo ảnh người và món đồ đang thử.');
    } catch (e: any) {
      Alert.alert('Gợi ý phụ kiện lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  async function runTryOn() {
    if (!person?.base64) {
      Alert.alert('Thiếu ảnh người', 'Hãy chọn/chụp ảnh của bạn trước.');
      return;
    }
    if (!mainProduct) {
      Alert.alert('Thiếu sản phẩm chính', 'Hãy quay lại sản phẩm bạn thích và bấm Thử đồ.');
      return;
    }

    try {
      setLoading(true);
      setResultImg('');
      const data = await v48Post('/api/v48/mobile/tryon-selected-product', {
        personImageBase64: person.base64,
        mainProductId: v48ProductId(mainProduct),
        accessoryProductIds: selectedAccessories.map(v48ProductId),
        sizeInfo,
        adultConfirmed,
      });

      const final = data?.finalImageBase64
        ? (String(data.finalImageBase64).startsWith('data:') ? data.finalImageBase64 : `data:image/png;base64,${data.finalImageBase64}`)
        : '';

      setResultImg(final);
      setTips(data?.tips || null);
      setMessage(data?.message || 'Đã tạo thử đồ bằng sản phẩm shop.');
      if (!final) {
        Alert.alert('Chưa có ảnh kết quả', data?.message || 'AI Gateway chưa trả ảnh.');
      }
    } catch (e: any) {
      Alert.alert('Thử đồ lỗi', e.message);
    } finally {
      setLoading(false);
    }
  }

  const mainImg = v48FirstImage(mainProduct);

  return (
    <ScrollView contentContainerStyle={s.container}>
      <Text style={s.title}>Thử đồ AI Shop V48</Text>
      <Text style={s.sub}>
        Đồ chính lấy từ sản phẩm bạn đã bấm trong shop. App dùng ảnh đầu tiên của sản phẩm. Không còn chọn/dán link ảnh sản phẩm.
      </Text>

      <View style={s.card}>
        <Text style={s.section}>Sản phẩm đang thử</Text>
        {mainProduct ? (
          <View style={s.mainProduct}>
            <Image source={{ uri: mainImg || 'https://placehold.co/500x700/fdf2f8/be185d?text=JAPANO' }} style={s.mainImg} />
            <View style={{ flex: 1 }}>
              <Text style={s.mainName}>{mainProduct.name}</Text>
              <Text style={s.price}>{money(mainProduct.price)}</Text>
              <Text style={s.note}>Ảnh đồ = ảnh đầu tiên của sản phẩm này.</Text>
            </View>
          </View>
        ) : (
          <Text style={s.warn}>Chưa nhận được sản phẩm. Hãy quay lại trang sản phẩm và bấm “Thử đồ”.</Text>
        )}
      </View>

      <View style={s.card}>
        <Text style={s.section}>1. Ảnh người dùng</Text>
        <View style={s.rowButtons}>
          <TouchableOpacity style={s.btnSec} onPress={() => pickImage(setPerson)}>
            <Text style={s.btnSecText}>Chọn ảnh của bạn</Text>
          </TouchableOpacity>
          <TouchableOpacity style={s.btnSec} onPress={() => takePhoto(setPerson)}>
            <Text style={s.btnSecText}>Chụp ảnh</Text>
          </TouchableOpacity>
        </View>
        {person?.uri ? <Image source={{ uri: person.uri }} style={s.personImg} /> : null}
      </View>

      {person?.uri ? (
        <View style={s.card}>
          <Text style={s.section}>2. Thông tin gợi ý</Text>
          <Text style={s.note}>Phần này chỉ xuất hiện sau khi bạn thêm ảnh. Bấm gợi ý để AI chọn lại phụ kiện phù hợp hơn.</Text>
          <TextInput
            style={[s.input, { minHeight: 76 }]}
            multiline
            value={sizeInfo}
            onChangeText={setSizeInfo}
            placeholder="Nhập chiều cao, cân nặng, eo, hông, cổ tay nếu muốn..."
          />
          <View style={s.row}>
            <Text style={{ flex: 1, color: '#9d174d', fontWeight: '800' }}>Xác nhận adult fashion nếu sản phẩm là bikini / đồ bơi / crop-top</Text>
            <Switch value={adultConfirmed} onValueChange={setAdultConfirmed} />
          </View>
          <TouchableOpacity style={s.btn} onPress={suggestAccessories} disabled={loading}>
            <Text style={s.btnText}>{loading ? 'Đang gợi ý...' : 'Gợi ý phụ kiện từ shop'}</Text>
          </TouchableOpacity>
        </View>
      ) : null}

      <View style={s.card}>
        <Text style={s.section}>{suggested ? '3. Phụ kiện AI gợi ý' : '3. Phụ kiện trong shop'}</Text>
        <Text style={s.note}>Chọn phụ kiện shop: dù, dây chuyền, khăn trùm đầu, đồng hồ, túi, kính, nón, bông tai...</Text>
        <TextInput style={s.input} placeholder="Tìm phụ kiện..." value={query} onChangeText={setQuery} />
        <FlatList
          horizontal
          data={visibleAccessories}
          keyExtractor={(p, i) => `${v48ProductId(p)}-${i}`}
          renderItem={({ item }) => (
            <AccessoryCard
              item={item}
              selected={selectedAccessories.some((x) => v48ProductId(x) === v48ProductId(item))}
              onPress={toggleAccessory}
            />
          )}
          showsHorizontalScrollIndicator={false}
        />
        <Text style={s.note}>Đã chọn: {selectedAccessories.map((x) => x.name).join(', ') || 'chưa chọn'}</Text>
      </View>

      {tips ? (
        <View style={s.card}>
          <Text style={s.section}>Kết quả gợi ý</Text>
          <Text style={s.note}>Tóm tắt: {tips.summary || '—'}</Text>
          <Text style={s.note}>Size: {(tips.sizeAdvice || []).join(' | ') || '—'}</Text>
          <Text style={s.note}>Phụ kiện: {(tips.accessoryAdvice || []).join(' | ') || '—'}</Text>
        </View>
      ) : null}

      <TouchableOpacity style={[s.btn, { backgroundColor: '#111827' }]} onPress={runTryOn} disabled={loading}>
        <Text style={s.btnText}>{loading ? 'Đang tạo...' : 'Tạo thử đồ với sản phẩm này'}</Text>
      </TouchableOpacity>

      <View style={s.card}>
        <Text style={s.section}>Trạng thái</Text>
        <Text style={s.note}>{message}</Text>
      </View>

      {resultImg ? (
        <View style={s.card}>
          <Text style={s.section}>Kết quả cuối</Text>
          <Image source={{ uri: resultImg }} style={s.result} />
          <Text style={s.note}>Nếu AI trả nhiều ảnh không giống nhau, app lấy ảnh đầu tiên làm final.</Text>
        </View>
      ) : null}
    </ScrollView>
  );
}

const s = StyleSheet.create({
  container: { padding: 16, gap: 14, backgroundColor: '#fff8fb' },
  title: { fontSize: 30, fontWeight: '900', color: '#831843', marginTop: 12 },
  sub: { color: '#6b7280', lineHeight: 20 },
  card: { backgroundColor: 'white', borderRadius: 18, padding: 14, borderWidth: 1, borderColor: '#fbcfe8', gap: 10 },
  section: { fontSize: 20, fontWeight: '900', color: '#9d174d' },
  mainProduct: { flexDirection: 'row', gap: 12, alignItems: 'center' },
  mainImg: { width: 98, height: 132, borderRadius: 14, backgroundColor: '#f3f4f6' },
  mainName: { fontWeight: '900', fontSize: 17, color: '#111827' },
  input: { borderWidth: 1, borderColor: '#f9a8d4', borderRadius: 12, padding: 12, backgroundColor: '#fff' },
  row: { flexDirection: 'row', alignItems: 'center', gap: 10 },
  rowButtons: { flexDirection: 'row', gap: 10 },
  btn: { backgroundColor: '#ec4899', borderRadius: 14, padding: 14, alignItems: 'center' },
  btnText: { color: 'white', fontWeight: '900' },
  btnSec: { flex: 1, backgroundColor: '#fdf2f8', borderRadius: 12, padding: 12, alignItems: 'center', borderWidth: 1, borderColor: '#f9a8d4' },
  btnSecText: { color: '#be185d', fontWeight: '900' },
  personImg: { width: '100%', height: 300, borderRadius: 16, backgroundColor: '#f3f4f6' },
  accCard: { width: 155, marginRight: 10, borderRadius: 18, backgroundColor: '#fff', borderWidth: 1, borderColor: '#fce7f3', overflow: 'hidden' },
  accSelected: { borderColor: '#ec4899', borderWidth: 3, backgroundColor: '#fdf2f8' },
  accImg: { width: '100%', height: 145, backgroundColor: '#f3f4f6' },
  accBody: { padding: 9 },
  accName: { fontWeight: '900', color: '#111827', minHeight: 40 },
  check: { position: 'absolute', top: 8, right: 8, backgroundColor: '#ec4899', borderRadius: 999, width: 26, height: 26, alignItems: 'center', justifyContent: 'center' },
  checkText: { color: 'white', fontWeight: '900' },
  price: { color: '#be185d', fontWeight: '900' },
  small: { color: '#6b7280', fontSize: 12 },
  note: { color: '#374151', lineHeight: 20 },
  warn: { color: '#be123c', fontWeight: '900' },
  result: { width: '100%', height: 520, borderRadius: 16, backgroundColor: '#f3f4f6' },
});
