import React from 'react';
import { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { Stack, router } from 'expo-router';
import { Feather } from '@expo/vector-icons';
import { Header } from '../components/Header';
import { useApp } from '../context/AppContext';
import { cardStyle, radius, scaleFont, shadow } from '../lib/styles';

export default function NotificationsScreen() {
  const { theme, cart, wishlist, orders } = useApp();
  const notices = [
    cart.length ? { icon: 'shopping-bag' as const, title: 'Giỏ hàng đang có sản phẩm', body: `Bạn có ${cart.length} sản phẩm trong giỏ. Bấm để kiểm tra và thanh toán.`, action: '/cart' } : null,
    wishlist.length ? { icon: 'heart' as const, title: 'Danh sách yêu thích đã lưu', body: `${wishlist.length} sản phẩm đang chờ bạn xem lại.`, action: '/wishlist' } : null,
    orders.length ? { icon: 'truck' as const, title: 'Theo dõi đơn hàng', body: `Bạn có ${orders.length} đơn hàng trong lịch sử mua sắm.`, action: '/profile' } : null,
    { icon: 'zap' as const, title: 'Thử đồ bằng Fotor', body: 'Trang thử đồ đã dùng Fotor API tạo ảnh và Cloudinary lưu media.', action: '/try-on' },
  ].filter(Boolean) as Array<{ icon: any; title: string; body: string; action: string }>;

  return (
    <View style={{ flex: 1, backgroundColor: theme.background }}>
      <Stack.Screen options={{ headerShown: false }} />
      <Header title="Thông báo" subtitle="Cập nhật nhanh về giỏ hàng, yêu thích, đơn hàng và AI thử đồ." />
      <ScrollView contentContainerStyle={styles.content} showsVerticalScrollIndicator>
        {notices.map((item, index) => (
          <Pressable key={`${item.title}-${index}`} onPress={() => router.push(item.action as any)} style={[cardStyle(theme), styles.card, shadow(theme)]}>
            <View style={[styles.iconBox, { backgroundColor: theme.primary }]}>
              <Feather name={item.icon} size={20} color={theme.background} />
            </View>
            <View style={{ flex: 1 }}>
              <Text style={[styles.title, { color: theme.heading, fontSize: scaleFont(theme, 17) }]}>{item.title}</Text>
              <Text style={[styles.body, { color: theme.muted, fontSize: scaleFont(theme, 13) }]}>{item.body}</Text>
            </View>
            <Feather name="chevron-right" size={20} color={theme.primary} />
          </Pressable>
        ))}
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  content: { padding: 16, gap: 12, paddingBottom: 120 },
  card: { flexDirection: 'row', alignItems: 'center', gap: 12, padding: 14, borderRadius: 0},
  iconBox: { width: 42, height: 42, borderRadius: 0, alignItems: 'center', justifyContent: 'center' },
  title: { fontWeight: '900' },
  body: { marginTop: 5, lineHeight: 19 },
});
