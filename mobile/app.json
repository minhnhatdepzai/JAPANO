{
  "expo": {
    "name": "JAPANO",
    "slug": "japano",
    "version": "1.0.19",
    "icon": "./assets/brand/japano-app-icon.png",
    "orientation": "portrait",
    "scheme": [
      "japano",
      "com.googleusercontent.apps.818888909731-ef99sfuk4784soea0c7fca922u2gkcfg"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/japano-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F0E5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.japano.app"
    },
    "android": {
      "package": "vn.japano.app",
      "versionCode": 20,
      "icon": "./assets/brand/japano-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/japano-adaptive-foreground.png",
        "backgroundColor": "#F6F0E5"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép JAPANO chọn ảnh để phân tích phong cách và thử đồ.",
          "cameraPermission": "Cho phép JAPANO chụp ảnh để thử đồ trực tiếp.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép JAPANO lưu ảnh và video kết quả vào thư viện của bạn.",
          "savePhotosPermission": "Cho phép JAPANO lưu ảnh và video kết quả vào thư viện của bạn.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8452F",
          "defaultChannel": "default"
        }
      ]
    ],
    "notification": {
      "iosDisplayInForeground": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "google": {
        "androidClientId": "818888909731-ef99sfuk4784soea0c7fca922u2gkcfg.apps.googleusercontent.com",
        "iosClientId": "",
        "webClientId": ""
      },
      "api": {
        "lanUrl": "http://192.168.1.51:4100",
        "tailscaleUrl": "https://rd-system.tail6502ce.ts.net:4101"
      }
    }
  }
}
