<mxfile host="app.diagrams.net" agent="JAPANO ERD (MongoDB Atlas)" pages="7">
  <diagram id="p0" name="00 — Bản đồ cụm">
    <mxGraphModel dx="2400" dy="1600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040" pageHeight="1532" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="map_t" value="ERD JAPANO — Bản đồ 6 cụm nghiệp vụ" style="text;html=1;align=left;verticalAlign=middle;fontSize=46;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="2600" height="64" as="geometry"/></mxCell>
        <mxCell id="map_s" value="MongoDB Atlas · database japano · 34 collection · 48 quan hệ · 1998 document" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="98" width="2800" height="36" as="geometry"/></mxCell>
        <mxCell id="map_n" value="Số trên mỗi đường = số khoá ngoại nối hai cụm (29 quan hệ liên cụm, 19 quan hệ trong cụm). Độ dày đường tỉ lệ với số đó. Chi tiết từng trường xem các trang cụm phía sau." style="text;html=1;align=left;verticalAlign=top;fontSize=19;fontColor=#333333;spacing=10;strokeColor=#999999;fillColor=#FAFAFA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="1192" width="1480" height="290" as="geometry"/></mxCell>
        <mxCell id="map_d" value="GHI CHÚ THIẾT KẾ (trả lời góp ý)&lt;br&gt;&lt;br&gt;1. ERD này ánh xạ 1-1 với MongoDB Atlas: mỗi hộp là một collection có thật, mỗi dòng là một khoá có thật trong document.&lt;br&gt;2. Màu sắc và kích cỡ KHÔNG phải collection riêng — chúng là trường nhúng (colorName, colorHex, size) trong product_variants và order_items.&lt;br&gt;3. Quan hệ nhiều-nhiều dùng mảng nhúng (cardIds, productIds, qualifyingOrderIds, recommendedProductIds), đúng theo mô hình tài liệu, không có bảng trung gian.&lt;br&gt;4. Bảng lịch sử: chỉ giữ những bảng có nơi đọc thật — interactions (nuôi máy gợi ý), chats (ngữ cảnh trợ lý), search_logs (thống kê từ khoá), moderation_samples (mẫu huấn luyện kiểm duyệt), voucher_redemptions (chứng từ). tryon_history đã bị loại bỏ vì trùng hoàn toàn với interactions type=tryon và không có mã nào đọc nó.&lt;br&gt;5. orders.history[] và return_requests.timeline[] là MẢNG NHÚNG trong chính document, không phải bảng lịch sử riêng." style="text;html=1;align=left;verticalAlign=top;fontSize=19;fontColor=#111111;spacing=14;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="1192" width="1290" height="290" as="geometry"/></mxCell>
        <mxCell id="cl0" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 1 — Danh mục sản phẩm &amp;amp; nội dung&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;categories&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Danh Mục Sản Phẩm · 5 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;products&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Sản Phẩm · 35 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;product_details&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Chi Tiết Sản Phẩm · 35 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;product_variants&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Biến Thể Sản Phẩm · 317 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;product_media&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Hình Ảnh Sản Phẩm · 115 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;ai_descriptions&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Mô Tả Sinh Bởi AI · 9 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;6 collection · 516 document · CỤM TRUNG TÂM&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=3.4;fillColor=#F2F2F2;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1130" y="790" width="780" height="310" as="geometry"/></mxCell>
        <mxCell id="cl1" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 2 — Người dùng &amp;amp; giỏ hàng&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Người Dùng · 36 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;profiles&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Hồ Sơ Vóc Dáng · 12 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;addresses&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Địa Chỉ Giao Hàng · 11 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;push_tokens&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Thiết Bị Nhận Thông Báo · 4 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;cart_items&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Chi Tiết Giỏ Hàng · 5 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;wishlist_items&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Sản Phẩm Yêu Thích · 14 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;6 collection · 82 document · CỤM TRUNG TÂM&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=3.4;fillColor=#F2F2F2;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1130" y="290" width="780" height="310" as="geometry"/></mxCell>
        <mxCell id="cl2" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 3 — Đơn hàng · Thanh toán · Trả hàng&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;orders&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Đơn Hàng · 97 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;order_items&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Chi Tiết Đơn Hàng · 158 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;payments&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Thanh Toán · 97 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;return_requests&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Yêu Cầu Trả Hàng · 10 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;4 collection · 362 document&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="780" height="246" as="geometry"/></mxCell>
        <mxCell id="cl3" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 4 — Khuyến mãi · Khách VIP · Thẻ địa danh&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;vouchers&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Phiếu Giảm Giá · 4 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;voucher_redemptions&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Lượt Sử Dụng Phiếu · 5 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;discount_rules&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Quy Tắc Giảm Giá · 3 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;vip_memberships&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Thành Viên VIP · 6 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;flagcards&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Thẻ Địa Danh · 7 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;flagcard_collections&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Bộ Sưu Tầm Thẻ · 4 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;6 collection · 29 document&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="2170" y="290" width="780" height="310" as="geometry"/></mxCell>
        <mxCell id="cl4" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 5 — Đánh giá &amp;amp; Kiểm duyệt&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;reviews&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Đánh Giá Sản Phẩm · 31 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;review_reactions&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Tương Tác Đánh Giá · 88 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;moderation_samples&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Mẫu Kiểm Duyệt · 6 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;japan_spot_reviews&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Đánh Giá Địa Điểm Nhật · 5 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;japan_spot_suggestions&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Đề Xuất Địa Điểm Nhật · 5 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;5 collection · 135 document&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="780" height="278" as="geometry"/></mxCell>
        <mxCell id="cl5" value="&lt;div style=&quot;font-size:26px;font-weight:bold;padding-bottom:12px&quot;&gt;Cụm 6 — Hành vi · AI gợi ý · Vận hành&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.45&quot;&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;interactions&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Tương Tác Người Dùng · 723 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;search_logs&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Nhật Ký Tìm Kiếm · 13 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;chats&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Hội Thoại Trợ Lý · 68 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;goals&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Mục Tiêu Tiết Kiệm · 8 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;notifications&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Thông Báo · 56 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;banners&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Quảng Cáo · 3 doc&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 0&quot;&gt;&lt;b&gt;settings&lt;/b&gt;&lt;span style=&quot;color:#666&quot;&gt; — Cấu Hình Cửa Hàng · 3 doc&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#666;padding-top:12px&quot;&gt;7 collection · 874 document&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;strokeColor=#000000;strokeWidth=2;fillColor=#FFFFFF;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="2170" y="790" width="780" height="342" as="geometry"/></mxCell>
