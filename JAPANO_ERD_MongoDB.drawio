        <mxCell id="p1_title" value="Cụm 1 — Danh mục sản phẩm &amp; nội dung" style="text;html=1;align=left;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="2600" height="58" as="geometry"/></mxCell>
        <mxCell id="p1_sub" value="MongoDB Atlas · database japano · 6 collection · 5 quan hệ · 516 document" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="2600" height="36" as="geometry"/></mxCell>
        <mxCell id="p1_legend" value="CHÚ GIẢI   ·   PK = khoá chính (gạch chân)   ·   FKn = khoá ngoại   ·   tên trường in đúng khoá thật trong MongoDB&lt;br&gt;Ký hiệu chân quạ:  ─|◄ một-và-chỉ-một   ·   ─o◄ không-hoặc-một   ·   ─o&lt; không-hoặc-nhiều&lt;br&gt;Trường kiểu mảng (vd cardIds, productIds) là quan hệ nhiều-nhiều nhúng ngay trong document, không có bảng trung gian." style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#333333;spacing=12;strokeColor=#999999;fillColor=#FAFAFA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="1108" width="1180" height="150" as="geometry"/></mxCell>
        <mxCell id="t_categories" value="Danh Mục Sản Phẩm [categories]" style="shape=table;startSize=48;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontStyle=1;align=left;spacingLeft=10;resizeLast=1;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#111111;strokeWidth=1.6;swimlaneFillColor=#E8E8E8;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="560" height="150" as="geometry"/></mxCell>
