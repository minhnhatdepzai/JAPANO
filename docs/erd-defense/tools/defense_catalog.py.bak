# 61 câu bổ sung; cộng 59 câu kế thừa trong make_md.py thành đúng 120 câu.
EXTRA_QUESTIONS = [
    ('Cột & ràng buộc','`users.googleId` dùng để làm gì và có unique không?','Nối danh tính Google; MongoDB hiện chưa có unique index riêng.','auth.js/lib/googleAuth.js + indexes users'),
    ('Cột & ràng buộc','Vì sao `passwordHash` được phép thiếu ở một số user?','Tài khoản Google-only có thể chưa đặt mật khẩu.','users field presence + authProviders'),
    ('Cột & ràng buộc','`authProviders` là snapshot hay state hiện tại?','Là state các cách đăng nhập hiện có, không phải chứng từ.','routes/auth.js publicUser/reset-password'),
    ('Cột & ràng buộc','`products.slug` unique nhưng đổi slug có rủi ro gì?','Link cũ và logical refs dùng slug có thể hỏng; cần redirect hoặc ID ổn định.','uq_products_slug + route lookup'),
    ('Cột & ràng buộc','`product_variants.sku` khác `id` thế nào?','SKU phục vụ kho/nghiệp vụ và có thể theo quy ước; id là định danh kỹ thuật.','uq_product_variants_sku'),
    ('Cột & ràng buộc','Khi nào `product_variants.price` được dùng?','Khi variant có giá riêng; nếu thiếu thì fallback về products.price.','lib/pricing.js + live count'),
    ('Cột & ràng buộc','`compareAtPrice=null` có nghĩa gì?','Không có giá niêm yết để so sánh, khác với giá 0.','products field null sample'),
    ('Cột & ràng buộc','Vì sao `order_items.position` cần tồn tại?','Giữ thứ tự dòng ổn định khi hydrate order từ collection riêng.','mongoCollections serialize/hydrate'),
    ('Cột & ràng buộc','`orders.total` phải thoả invariant nào?','Bằng subtotal - các khoản giảm + ship, chặn dưới 0 tại lúc tạo.','routes/orders.js createOrderInState'),
    ('Cột & ràng buộc','`orders.history` có thay thế audit log bất biến không?','Chưa; nó là mảng trong document và có thể bị sửa cùng order.','orders.history implementation'),
    ('Cột & ràng buộc','Tại sao `payments.currency` đang có cả `vnd` và `VND`?','Dữ liệu/provider chưa chuẩn hoá casing; so sánh phải normalize.','live payments field enum'),
    ('Cột & ràng buộc','`payments.card.last4` có phải dữ liệu thẻ đầy đủ không?','Không; chỉ metadata hiển thị, backend không nhận/lưu PAN hoặc CVC.','paymentsStripe.js CardField flow'),
    ('Cột & ràng buộc','Vì sao `return_requests.paymentId` nullable?','COD chưa thu qua gateway có thể không có payment cần hoàn online.','returns.js needsGatewayRefund'),
    ('Cột & ràng buộc','`reviews.userName` có dư thừa với users.name không?','Đó là snapshot tên hiển thị lúc review; cần nêu policy khi user yêu cầu ẩn danh.','routes/reviews.js create review'),
    ('Cột & ràng buộc','`review_reactions.value` nhận những giá trị nào?','Chỉ `helpful` hoặc `not_helpful`, app route kiểm tra enum.','routes/reviews.js reaction'),
    ('Cột & ràng buộc','Vì sao `profiles.userId` có unique index?','Bản số vật lý là user 1 : 0..1 profile hiện tại.','uq_profiles_user'),
    ('Cột & ràng buộc','Vì sao `payments.orderId` chỉ index thường?','Cho phép nhiều attempt cho một order; unique sẽ khoá cứng 1:1.','live index payments'),
    ('Cột & ràng buộc','Vì sao `orders.clientRequestId` cần unique DB?','Application lookup không đủ ở nhiều instance; duplicate order vẫn có thể lọt.','orders.js + missing index'),
    ('Quan hệ','Hai dây từ vouchers tới users có cùng nghĩa không?','Không: ownerId là người cấp, userId là người nhận mục tiêu.','erd.drawio relationship rows'),
    ('Quan hệ','Vì sao order nối voucher và vẫn lưu discountCode/discount?','FK giải thích nguồn rule; snapshot giữ kết quả tiền lịch sử.','orders serialization + snapshot fields'),
    ('Quan hệ','`reviews.orderId` chứng minh điều gì và chưa chứng minh điều gì?','Chứng minh order nguồn; code còn kiểm tra completed/successful và chứa product.','reviewPurchaseOrders'),
    ('Quan hệ','Quan hệ chats–products có bắt buộc không?','Không; message chung không cần productId, message theo sản phẩm mới có context.','ERD + chats fields'),
    ('Quan hệ','Tại sao flagcards–products là N:N nhưng không có bridge collection?','Implementation nhúng `recommendedProductIds[]` vì mapping nhỏ/đọc cùng card.','flagcards schema'),
    ('Quan hệ','`flagcard_collections.cardIds[]` đánh đổi gì?','Đọc aggregate nhanh nhưng khó unique/atomic nhiều instance và analytics theo card.','flagcard collection implementation'),
    ('Quan hệ','Xoá category đang có products nên làm gì?','RESTRICT hoặc reassign; cascade products sẽ làm mất catalog hàng loạt.','products.categoryId'),
    ('Quan hệ','Xoá review thì reactions nên xử lý thế nào?','Cascade mapping vì reaction không có nghĩa độc lập; nếu chỉ hide review có thể giữ audit.','review_reactions relationship'),
    ('Quan hệ','Product archive có nên xoá wishlist rows không?','Tuỳ UX: có thể giữ để báo unavailable; phải quy định rõ, không cascade mù.','wishlist/product lifecycle'),
    ('Quan hệ','Một order có thể có nhiều return request không?','Có; code trả danh sách và hỗ trợ các đợt/item khác nhau.','routes/orders.js comment + returns'),
    ('MongoDB','Logical FK khác database-native FK thế nào?','Logical FK chỉ là field/ý nghĩa; MongoDB không tự reject orphan như RDBMS.','relationshipErrors()'),
    ('MongoDB','`relationshipErrors()` chạy lúc nào?','Trước write ở nhánh Mongo và trong persistStateToCollections; nhánh JSON writeFile không gọi.','lib/store.js/mongoCollections.js'),
    ('MongoDB','Vì sao JSON fallback là chế độ suy giảm chứ không phải nguồn ngang hàng?','MongoDB là primary; fallback giữ demo sống nhưng enforcement/persistence khác.','store.initialize/activateFileFallback'),
    ('MongoDB','Debounce 40 ms tối ưu gì và đánh đổi gì?','Gộp write Mongo; đổi lại acknowledged response có thể đi trước durable persistence.','scheduleMongoPersistence'),
    ('MongoDB','Nếu write liên tục dưới 40 ms thì mất tối đa một write đúng không?','Không chắc; timer bị reset, có thể còn nhiều thay đổi chưa flush từ lần persist cuối.','store.js debounce logic'),
    ('MongoDB','`replaceCollection()` cập nhật theo document hay thay cả projection?','Upsert toàn bộ docs rồi delete `_id` không còn trong snapshot; đây là snapshot replacement theo collection.','mongoCollections.js replaceCollection'),
    ('MongoDB','Vì sao giữ toàn state trong RAM là trần scale?','Mỗi read structuredClone toàn state và mỗi persist tuần tự nhiều collection.','store.js read/write'),
    ('MongoDB','Index unique có làm mọi write atomic đa collection không?','Không; nó chỉ bảo vệ invariant của index trên một collection.','MongoDB design + code'),
    ('MongoDB','Có schema validator MongoDB không?','Không thấy khai báo validator; cấu trúc/ràng buộc chủ yếu nằm ở code và indexes.','mongoCollections ensureMongoIndexes'),
    ('MongoDB','Vì sao `_id` và `id` cùng tồn tại?','`_id` là PK vật lý Mongo; `id` giữ API/domain ID nhất quán khi hydrate state.','serializeDirectRow + indexes'),
    ('Concurrency','Test 50 lượt/tồn 5 chứng minh phạm vi nào?','Chỉ chứng minh synchronous store update trong một process/file-mode test.','checkout-concurrency.test.js'),
    ('Concurrency','Test đó không chứng minh điều gì?','Không chứng minh nhiều process/pod cùng ghi Mongo an toàn.','test comment LIMIT'),
    ('Concurrency','Atomic conditional stock update có điều kiện gì?','Update variant khi `stock >= qty`, decrement trong cùng lệnh, kiểm modifiedCount.','đề xuất production'),
    ('Concurrency','Application check email an toàn trong một process tới đâu?','Mutator sync serialize được register route hiện tại; async/multi-instance vẫn cần DB unique.','auth register + store.update'),
    ('Concurrency','Review route recheck duplicate sau moderation để làm gì?','Đóng cửa sổ async trong cùng process; chưa thay DB unique ở nhiều instance.','reviews.js lines 55-68'),
    ('Concurrency','`clientRequestId` có nên unique toàn hệ thống không?','Nên scope theo user/channel; unique toàn cục phụ thuộc cách client sinh ID.','orders create logic'),
    ('Concurrency','Webhook Stripe và reconcile cùng chạy có gửi hai biên nhận không?','Code ghi `wasPaid` và chỉ gửi khi chuyển sang paid lần đầu trong state hiện tại.','finalizeStripe*'),
    ('Concurrency','Refund webhook lặp được chống bằng gì?','Upsert entry theo refund.id trong `payment.refunds`.','applyStripeRefundToState'),
    ('Thanh toán','Ai là source of truth khi DB nói pending nhưng Stripe nói succeeded?','Provider; route read/reconcile truy vấn ngược rồi finalize local state.','payments.js + stripe/reconcile'),
    ('Thanh toán','VNPay return và IPN cùng tới thì sao?','Nếu payment đã paid, finalize trả `already_done`, không gửi receipt lần nữa.','paymentsVnpay.js'),
    ('Thanh toán','Stripe idempotency key đang dùng ở đâu?','Tạo PaymentIntent/Checkout và refund dùng key dẫn xuất từ order/attempt/request.','paymentsStripe.js'),
    ('Thanh toán','`transactionCode` có unique index chưa?','Chưa; hiện chỉ có index id/orderId/userId ở payments.','live Mongo indexes'),
    ('Thanh toán','94 orders/94 payments có kết luận 1:1 được không?','Không; current data là 1:1, index orderId non-unique cho phép 1:N.','live counts/index'),
    ('Thanh toán','Partial refund làm order luôn `returned` không?','Không; chỉ toàn bộ item/amount mới chuyển returned, partial giữ lịch sử phù hợp.','returns.js/applyStripeRefundToState'),
    ('Tình huống','Product đổi tên sau khi mua: field nào bảo vệ lịch sử?','`order_items.productName` cùng slug/màu/cỡ/price snapshot.','live order_items fields'),
    ('Tình huống','User đổi email: những FK nào phải update?','Không FK nào nếu đều trỏ `users.id`; email chỉ là thuộc tính đăng nhập.','ERD logical FKs'),
    ('Tình huống','Admin khoá user khi order đang shipping thì sao?','Login bị chặn nhưng order/chứng từ giữ nguyên; fulfillment là vòng đời độc lập.','auth status + order data'),
    ('Tình huống','Voucher hết hạn giữa lúc mở giỏ và tạo order thì sao?','Server validate lại lúc create order và từ chối nếu hết hạn.','orders validateVoucher'),
    ('Tình huống','MongoDB lỗi sau response nhưng trước persist thì sao?','Write đã ở RAM; persist catch chuyển fallback, nhưng durability/consistency cần nói rõ và đối soát.','store schedule/catch fallback'),
    ('Tình huống','Xoá asset Cloudinary nhưng URL Mongo còn thì hậu quả gì?','Broken media; cần outbox/retry hoặc trạng thái đồng bộ asset.','media storage boundary'),
    ('Đổi yêu cầu','Một user nhiều provider đăng nhập nên thêm gì?','Tách `user_identities(userId,provider,providerSubject)` với unique provider+subject.','current googleId/authProviders limitation'),
    ('Đổi yêu cầu','Một order chia nhiều shipment nên thêm gì?','`shipments` và `shipment_items`; order 1:N shipments, line item phân bổ theo quantity.','current order has one fulfillment state'),
    ('Đổi yêu cầu','Voucher chỉ áp cho một category nên thêm gì?','Mapping `voucher_categories` hoặc scope rule; checkout kiểm item category.','current voucher scope limitation'),
