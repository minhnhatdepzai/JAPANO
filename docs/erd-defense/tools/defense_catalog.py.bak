# -*- coding: utf-8 -*-
"""Dữ liệu dùng chung cho hồ sơ bảo vệ ERD JAPANO.

File này chỉ mô tả những gì đã đối chiếu với erd.drawio, MongoDB và backend.
Nhãn vật lý dùng tên collection/field thật; tên tiếng Việt dùng đúng sơ đồ logic.
"""

MAP = {
    'Người Dùng': 'users', 'Hồ Sơ Người Dùng': 'profiles', 'Địa Chỉ': 'addresses',
    'Sản Phẩm': 'products', 'Chi Tiết Sản Phẩm': 'product_details',
    'Biến Thể Sản Phẩm': 'product_variants',
    'Hình Ảnh Giao Diện Sản Phẩm': 'product_media', 'Hình Ảnh': None,
    'Màu Sắc': None, 'Kích Thước': None, 'Danh Mục Sản Phẩm': 'categories',
    'Mô Tả Sản Phẩm Tạo Bởi AI': 'ai_descriptions', 'Đơn Hàng': 'orders',
    'Chi Tiết Đơn Hàng': 'order_items', 'Thanh Toán': 'payments',
    'Yêu Cầu Trả Hàng': 'return_requests', 'Chi Tiết Giỏ Hàng': 'cart_items',
    'Danh Sách Sản Phẩm Yêu Thích': 'wishlist_items', 'Đánh Giá Sản Phẩm': 'reviews',
    'Tương Tác Đánh Giá': 'review_reactions', 'Mẫu Kiểm Duyệt': 'moderation_samples',
    'Phiếu Giảm Giá': 'vouchers', 'Lượt Sử Dụng Phiếu': 'voucher_redemptions',
    'Quy Tắc Giảm Giá': 'discount_rules', 'Thành Viên VIP': 'vip_memberships',
    'Thẻ Địa Danh': 'flagcards', 'Bộ Sưu Tầm Thẻ Của Người Dùng': 'flagcard_collections',
    'Mục Tiêu Tiết Kiệm': 'goals', 'Đánh Giá Địa Điểm Nhật Bản': 'japan_spot_reviews',
    'Thông Báo': 'notifications', 'Tin Nhắn': 'chats',
    'Tương Tác Người Dùng': 'interactions', 'Lịch Sử Tìm Kiếm': 'search_logs',
    'Lịch Sử Thử Đồ': 'tryon_history', 'Cấu Hình Cửa Hàng': 'settings',
    'Quảng Cáo': 'banners',
}

TIER = {name: 'B' for name in MAP}
for name in ['Người Dùng', 'Sản Phẩm', 'Biến Thể Sản Phẩm', 'Đơn Hàng',
             'Chi Tiết Đơn Hàng', 'Thanh Toán']:
    TIER[name] = 'S'
for name in ['Đánh Giá Sản Phẩm', 'Chi Tiết Giỏ Hàng',
             'Danh Sách Sản Phẩm Yêu Thích', 'Yêu Cầu Trả Hàng',
             'Phiếu Giảm Giá', 'Lượt Sử Dụng Phiếu', 'Danh Mục Sản Phẩm', 'Địa Chỉ']:
    TIER[name] = 'A'
for name in ['Tương Tác Người Dùng', 'Lịch Sử Tìm Kiếm', 'Lịch Sử Thử Đồ',
             'Tin Nhắn', 'Mô Tả Sản Phẩm Tạo Bởi AI', 'Mẫu Kiểm Duyệt',
             'Quảng Cáo', 'Cấu Hình Cửa Hàng']:
    TIER[name] = 'C'


def _entity(purpose, breaks, scenario, weakness, extension, delete, opener, question):
    return dict(purpose=purpose, breaks=breaks, scenario=scenario, weakness=weakness,
                extension=extension, delete=delete, opener=opener, question=question)


