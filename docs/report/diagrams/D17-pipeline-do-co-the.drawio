<mxfile host="japano-report" type="device"><diagram name="Đường ống ảnh → số đo"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="1. Kiểm tra chất lượng ảnh&lt;br&gt;độ phân giải, độ nét, độ phủ cơ thể" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="400" height="70" as="geometry"/></mxCell><mxCell id="n3" value="2. YOLOv8n-pose — 17 khớp&lt;br&gt;loại khớp conf &lt; 0,5 và khớp sát mép ảnh 1,5%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="400" height="70" as="geometry"/></mxCell><mxCell id="n4" value="3. Chọn chủ thể chính&lt;br&gt;diện tích, chiều cao khung, vị trí, độ tin cậy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="400" height="70" as="geometry"/></mxCell><mxCell id="n5" value="4. U2Net — tách silhouette" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="400" height="70" as="geometry"/></mxCell><mxCell id="n6" value="5. body_geometry.torso_profile&lt;br&gt;cắt hai cánh tay bằng khung xương" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="400" height="70" as="geometry"/></mxCell><mxCell id="n7" value="6. Đặc trưng hình học chuẩn hoá&lt;br&gt;bề ngang ngực/eo/hông, tỉ lệ, clothing_slack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="400" height="70" as="geo