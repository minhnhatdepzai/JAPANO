<mxfile host="japano-report" type="device"><diagram name="GPU arbiter"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="GPU NVIDIA RTX 5060 Ti — 16 311 MiB VRAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#A33A2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1120" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Hàng chờ ưu tiên — chỉ một job sinh ảnh/video chạy tại một thời điểm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1120" height="45" as="geometry"/></mxCell><mxCell id="n4" value="motion — 300&lt;br&gt;độc quyền GPU và RAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#A33A2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="250" height="70" as="geometry"/></mxCell><mxCell id="n5" value="tryon / swimwear — 200&lt;br&gt;độc quyền cho FASHN và FLUX.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#A33A2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="190" width="260" height="70" as="geometry"/></mxCell><mxCell id="n6" value="vision — 120&lt;br&gt;Qwen3-VL mô tả ảnh sản phẩm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="250" height="70" as="geometry"/></mxCell><mxCell id="n7" value="recommendation — 100&lt;br&gt;embedding ngữ nghĩa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#6B7255;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="240" height="70" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="Chuyển màn hình → đổi focus profile:&lt;br&gt;cancel job đang chờ, abort request đang chạy,&lt;br&gt;gọi /unload để nhả VRAM, đổi thiết bị của embedding" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="480" height="90" as="geometry"/></mxCell><mxCell id="n13" value="beginGpuJob / endGpuJob&lt;br&gt;Bảo vệ job đang chạy khỏi chính báo cáo focus của màn hình đó.&lt;br&gt;Trước khi có cặp hàm này, màn hình thử đồ tự báo focus &quot;browse&quot;&lt;br&gt;và giết chính lượt thử đồ mình vừa gửi đi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBE6;strokeColor=#B7A66B;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="600" height="90" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="Vì sao cần: try-on chiếm khoảng 15 GB và motion khoảng 13,5 GB, trong khi card chỉ có&lt;br&gt;16 GB. Nạp đồng thời là OOM chắc chắn. Chính sách &quot;giữ đến khi xong&quot; được chọn thay cho&lt;br&gt;chia sẻ thời gian vì hai model đều mất hàng chục giây chỉ để nạp — tráo qua lại giữa&lt;br&gt;chừng sẽ làm cả hai job chậm hơn là xếp hàng." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBE6;strokeColor=#B7A66B;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1120" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>