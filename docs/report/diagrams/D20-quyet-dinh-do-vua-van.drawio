<mxfile host="japano-report" type="device"><diagram name="Quyết định độ vừa vặn"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Đầu vào: size khách chọn, size khuyến nghị,&lt;br&gt;số đo hợp nhất, kết quả phân tích ảnh, vùng cơ thể" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#A33A2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="480" height="70" as="geometry"/></mxCell><mxCell id="n3" value="Có đủ hai&lt;br&gt;bậc size?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A33A2F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="160" height="80" as="geometry"/></mxCell><mxCell id="n4" value="verdict = unknown&lt;br&gt;không sinh hiệu ứng nào" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#6B7255;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="150" width="300" height="60" as="geometry"/></mxCell><mxCell id="n5" value="Có số đo vòng thật&lt;br&gt;của vùng tương ứng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A33A2F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="220" height="90" as="geometry"/></mxCell><mxCell id="n6" value="ease = vòng theo bảng size − vòng cơ thể&lt;br&gt;ease &lt; 0 → chật; 0 ≤ ease ≤ 9 cm → vừa; &gt; 9 cm → rộng&lt;br&gt;severity = |ease| / 22 (chật) hoặc (ease − 9) / 24 (rộng)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="370" width="460" height="80" as="geometry"/></mxCell><mxCell id="n7" value="Chỉ có bậc size: 1 bậc → 0,34 · 2 bậc → 0,66 · ≥ 3 bậc → 0,88+&lt;br&gt;BMI ước lượng và tỉ lệ bề ngang chỉ hiệu chỉnh nhẹ (±0,05…0,08)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="460" height="80" as="geometry"/></mxCell><mxCell id="n8" value="severity = max(ease, 0,45·delta + 0,55·ease); số đo thật chỉ được ĐẨY LÊN, không kéo xuống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#A33A2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="480" width="850" height="50" as="geometry"/></mxCell><mxCell id="n9" value="≤ 0,12 vừa · ≤ 0,42 hơi chật/hơi rộng · ≤ 0,72 chật/rộng · &gt; 0,72 rất chật/rất rộng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243244;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="555" width="850" height="45" as="geometry"/></mxCell><mxCell id="n10" value="Cho phép hiệu ứng bục đường may?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A33A2F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="625" width="380" height="50" as="geometry"/></mxCell><mxCell id="n11" value="KHÔNG — quần, chân váy, đồ bơi, crop top,&lt;br&gt;hoặc severity &lt; 0,85: chỉ vải căng và hằn nhẹ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#6B7255;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="615" width="440" height="70" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="ba tầng chặn độc lập" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#243244;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="Nguyên tắc bất di bất dịch: giữ nguyên cơ thể người dùng, chỉ đổi cách vải ôm và rủ.&lt;br&gt;Không làm người gầy đi cho vừa áo nhỏ, cũng không làm người to ra cho vừa áo rộng.&lt;br&gt;Với đồ bơi và đồ hở, một vết bục đồng nghĩa với làm lộ thêm cơ thể, nên bị cấm tuyệt đối." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBE6;strokeColor=#B7A66B;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="850" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>